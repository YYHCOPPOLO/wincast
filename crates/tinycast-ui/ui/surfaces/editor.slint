// The command/quicklink editor and the single-field text prompt: one Slint
// form window that replaces the old nested-pump native sheets. Width is the
// 480 DIP editor sheet; height follows the content, so the prompt variant is
// shorter. Copy arrives from i18n; no English lives here.
import { Theme } from "../theme.slint";
import { Checkbox } from "../primitives/checkbox.slint";
import { MagInput, MagPrimaryButton, MagTextButton } from "../primitives/magpie.slint";

export component EditorWindow inherits Window {
    in property <string> window-title;
    in property <string> name-label;
    in property <string> value-label;
    in property <string> confirm-label;
    in property <string> accept-label;
    in property <string> cancel-label;
    in property <bool> show-confirm: true;
    // The text prompt hides the name row and shows one field.
    in property <bool> name-hidden: false;
    in-out property <string> name-text;
    in-out property <string> value-text;
    in-out property <bool> confirm-checked: false;
    callback accepted();
    callback cancelled();

    title: root.window-title;
    preferred-width: Theme.size-editor-sheet-width;
    preferred-height: form.preferred-height;
    min-width: Theme.size-editor-sheet-width;
    min-height: form.preferred-height;
    background: Theme.page;
    default-font-family: "Segoe UI";
    default-font-size: Theme.font-row;

    // The window-level keys: Esc cancels wherever the focus sits; Enter in a
    // field reaches the field's own `accepted` first.
    scope := Rectangle {
        width: 100%;
        height: 100%;

        form := VerticalLayout {
            padding: Theme.spacing-xxl;
            spacing: Theme.spacing-section;

            // A conditional row: an invisible row would still take layout
            // space, and the prompt variant must be a shorter window. The
            // command variant's name field takes the keyboard on creation.
            if !root.name-hidden: VerticalLayout {
                spacing: Theme.spacing-section-header-bottom;

                Text {
                    text: root.name-label;
                    font-size: Theme.font-section;
                    color: Theme.text-secondary;
                    overflow: elide;
                }

                name-field := MagInput {
                    text-value <=> root.name-text;
                    accepted => { root.accepted(); }
                    init => { self.focus-field(); }
                }
            }

            VerticalLayout {
                spacing: Theme.spacing-section-header-bottom;

                Text {
                    text: root.value-label;
                    font-size: Theme.font-section;
                    color: Theme.text-secondary;
                    overflow: elide;
                }

                value-field := MagInput {
                    text-value <=> root.value-text;
                    accepted => { root.accepted(); }
                }
            }

            if root.show-confirm: HorizontalLayout {
                spacing: Theme.spacing-sm;
                alignment: start;

                Checkbox {
                    checked: root.confirm-checked;
                    toggled(value) => { root.confirm-checked = value; }
                }

                Text {
                    text: root.confirm-label;
                    font-size: Theme.font-row;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Rectangle {
                height: Theme.spacing-section-header-bottom;
                background: transparent;
            }

            HorizontalLayout {
                height: Theme.size-magpie-input;
                spacing: Theme.spacing-sm;
                alignment: end;

                save-btn := MagPrimaryButton {
                    label: root.accept-label;
                    clicked => { root.accepted(); }
                }

                MagTextButton {
                    label: root.cancel-label;
                    clicked => { root.cancelled(); }
                }
            }
        }
    }

    // The host calls this once the HWND exists. The command variant's name
    // field already took the keyboard in its own init; the prompt variant
    // starts on the value field.
    public function focus-first-field() {
        if (root.name-hidden) {
            value-field.focus-field();
        }
    }
}
