// The settings window: a native-framed 900 × 700 page. The sidebar and the
// detail column share the page fill; cards are surface.
//
// The sidebar is built from tinycast_pure::layout::settings::sidebar_rows, so
// the 22 DIP section headers, 32 DIP tab rows and the 215 DIP column are the
// same geometry the Direct2D window used. Both columns scroll; Slint reveals
// the focused row inside its Flickable on its own.
import { Theme } from "../theme.slint";
import { Scrollbar } from "../primitives/scrollbar.slint";
import { SettingsRow, SidebarRow } from "../primitives/form.slint";

// One row of the sidebar: kind 0 is a section header, kind 1 a SettingsTab.
// tab carries the SettingsTab discriminant; headers use -1.
export struct SettingsSidebarRow {
    kind: int,
    top: length,
    height: length,
    label: string,
    symbol: string,
    tab: int,
}

// One row of a settings page: kind 0 is a section header (title is the
// section name), kind 1 is a control row. id is the action the host runs.
export struct SettingsPageRow {
    kind: int,
    id: int,
    title: string,
    subtitle: string,
    trailing: string,
    // 0 none, 1 switch, 2 trailing label, 3 shortcut well.
    control: int,
    checked: bool,
    active: bool,
    enabled: bool,
}

// A heading plus one surface card of rows, scrolled as a whole. General,
// Permissions and Backup share it; 15 placeholder tabs do not use a card.
component RowsPage inherits Rectangle {
    in property <string> heading;
    in property <string> footnote;
    in property <[SettingsPageRow]> rows;
    callback row-activated(int);

    background: transparent;

    flick := Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        interactive: true;
        content-width: self.width;
        content-height: Math.max(self.height, body.height);

        body := Rectangle {
            width: parent.width;
            height: stack.preferred-height + Theme.spacing-xxl * 2;
            background: transparent;

            stack := VerticalLayout {
                x: Theme.spacing-xxl;
                y: Theme.spacing-xxl;
                width: parent.width - Theme.spacing-xxl * 2;
                spacing: Theme.spacing-md;

                Text {
                    text: root.heading;
                    font-size: Theme.font-panel-title;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                Rectangle {
                    background: Theme.card-fill;
                    border-width: Theme.size-hairline;
                    border-color: Theme.card-stroke;
                    border-radius: Theme.radius-card;

                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: 0px;

                        for row in root.rows: Rectangle {
                            height: row.kind == 0
                                ? Theme.size-section-header-height
                                : Theme.size-settings-row-height;
                            background: transparent;

                            if row.kind == 0: Text {
                                x: Theme.spacing-md;
                                width: parent.width - Theme.spacing-md * 2;
                                height: parent.height;
                                text: row.title;
                                font-size: Theme.font-section;
                                font-weight: 500;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if row.kind == 1: SettingsRow {
                                x: 0;
                                width: parent.width;
                                height: parent.height;
                                title: row.title;
                                subtitle: row.subtitle;
                                trailing: row.trailing;
                                control: row.control;
                                checked: row.checked;
                                active: row.active;
                                enabled: row.enabled;
                                activated => { root.row-activated(row.id); }
                            }
                        }
                    }
                }

                if root.footnote != "": Text {
                    text: root.footnote;
                    font-size: Theme.font-section;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }
            }
        }
    }

    Scrollbar {
        x: parent.width - Theme.size-scrollbar-inset - self.width;
        y: Theme.size-scrollbar-inset;
        height: parent.height - Theme.size-scrollbar-inset * 2;
        content-height: flick.content-height;
        viewport-height: flick.height;
        offset: -flick.content-y;
    }
}

// About: the heart mark, product/version, the Support and About rows, and the
// Slint Royalty-free 2.0 disclosure the design requires. The std-widgets
// AboutSlint badge is not linked in this build, so the mark and version are
// text here instead of the SVG.
component AboutPage inherits Rectangle {
    in property <string> heading;
    in property <string> product;
    in property <string> version;
    in property <string> tagline;
    in property <string> heart;
    in property <[SettingsPageRow]> rows;
    in property <string> disclosure-title;
    in property <string> disclosure-note;
    in property <string> disclosure-link;
    in property <string> copyright;
    callback row-activated(int);
    callback link-clicked();

    background: transparent;

    flick := Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        interactive: true;
        content-width: self.width;
        content-height: Math.max(self.height, body.height);

        body := Rectangle {
            width: parent.width;
            height: stack.preferred-height + Theme.spacing-xxl * 2;
            background: transparent;

            stack := VerticalLayout {
                x: Theme.spacing-xxl;
                y: Theme.spacing-xxl;
                width: parent.width - Theme.spacing-xxl * 2;
                spacing: Theme.spacing-md;

                Text {
                    text: root.heading;
                    font-size: Theme.font-panel-title;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                Text {
                    text: root.heart;
                    font-family: "Segoe Fluent Icons";
                    font-size: Theme.size-dialog-symbol-container;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.product;
                    font-size: Theme.font-row;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.version;
                    font-size: Theme.font-section;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.tagline;
                    font-size: Theme.font-section;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    background: Theme.card-fill;
                    border-width: Theme.size-hairline;
                    border-color: Theme.card-stroke;
                    border-radius: Theme.radius-card;

                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: 0px;

                        for row in root.rows: SettingsRow {
                            title: row.title;
                            subtitle: row.subtitle;
                            trailing: row.trailing;
                            control: row.control;
                            checked: row.checked;
                            active: row.active;
                            enabled: row.enabled;
                            activated => { root.row-activated(row.id); }
                        }
                    }
                }

                Rectangle {
                    background: Theme.card-fill;
                    border-width: Theme.size-hairline;
                    border-color: Theme.card-stroke;
                    border-radius: Theme.radius-card;

                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        Text {
                            text: root.disclosure-title;
                            font-size: Theme.font-section;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }

                        Text {
                            text: root.disclosure-note;
                            font-size: Theme.font-row;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        SettingsRow {
                            title: root.disclosure-link;
                            control: 0;
                            activated => { root.link-clicked(); }
                        }
                    }
                }

                Text {
                    text: root.copyright;
                    font-size: Theme.font-section;
                    color: Theme.text-tertiary;
                    horizontal-alignment: center;
                }
            }
        }
    }

    Scrollbar {
        x: parent.width - Theme.size-scrollbar-inset - self.width;
        y: Theme.size-scrollbar-inset;
        height: parent.height - Theme.size-scrollbar-inset * 2;
        content-height: flick.content-height;
        viewport-height: flick.height;
        offset: -flick.content-y;
    }
}

// The 15 tabs phase 8 fills: the tab title and one neutral i18n line, no fake
// controls.
component PlaceholderPage inherits Rectangle {
    in property <string> heading;
    in property <string> note;

    background: transparent;

    VerticalLayout {
        x: Theme.spacing-xxl;
        y: Theme.spacing-xxl;
        width: parent.width - Theme.spacing-xxl * 2;
        spacing: Theme.spacing-md;
        alignment: start;

        Text {
            text: root.heading;
            font-size: Theme.font-panel-title;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
        }

        Text {
            text: root.note;
            font-size: Theme.font-row;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}

export component SettingsWindow inherits Window {
    in property <string> window-title;
    in property <[SettingsSidebarRow]> sidebar-rows;
    in property <length> sidebar-content-height: 0px;
    // The SettingsTab discriminant AppCore selected; the only selection source.
    in property <int> selected-tab: 0;
    // 0 General, 1 Permissions, 2 About, 3 Backup, 4 the placeholder tabs.
    in property <int> page-kind: 0;
    in property <[SettingsPageRow]> general-rows;
    in property <[SettingsPageRow]> permissions-rows;
    in property <[SettingsPageRow]> backup-rows;
    in property <[SettingsPageRow]> about-rows;
    in property <string> general-heading;
    in property <string> permissions-heading;
    in property <string> backup-heading;
    in property <string> backup-footnote;
    in property <string> about-heading;
    in property <string> about-product;
    in property <string> about-version;
    in property <string> about-tagline;
    in property <string> about-heart;
    in property <string> about-disclosure-title;
    in property <string> about-disclosure-note;
    in property <string> about-disclosure-link;
    in property <string> about-copyright;
    in property <string> placeholder-heading;
    in property <string> placeholder-note;

    callback tab-selected(int);
    callback general-row-activated(int);
    callback permissions-row-activated(int);
    callback backup-row-activated(int);
    callback about-row-activated(int);
    callback slint-link-clicked();

    // Bumped when the keyboard should land on the selected tab (on show).
    private property <int> focus-generation: 0;

    title: root.window-title;
    // Initial size; the old window could be resized, so it is a preferred size
    // plus the minimum the old WM_GETMINMAXINFO enforced.
    preferred-width: Theme.size-settings-window-width;
    preferred-height: Theme.size-settings-window-height;
    min-width: Theme.size-settings-sidebar + Theme.size-settings-detail-minimum;
    min-height: Theme.size-settings-window-height;
    background: Theme.page;
    default-font-family: "Segoe UI";
    default-font-size: Theme.font-row;

    public function focus-selected-tab() {
        root.focus-generation += 1;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: Theme.size-settings-sidebar;
        height: root.height;
        background: Theme.settings-sidebar;
        clip: true;

        sidebar := Flickable {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            interactive: true;
            content-width: self.width;
            content-height: Math.max(self.height, root.sidebar-content-height);

            for row in root.sidebar-rows: Rectangle {
                x: 0;
                y: row.top;
                width: 100%;
                height: row.height;
                background: transparent;

                if row.kind == 0: Text {
                    x: Theme.spacing-xl;
                    width: parent.width - Theme.spacing-xl - Theme.spacing-md;
                    height: parent.height;
                    text: row.label;
                    font-size: Theme.font-section;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if row.kind == 1: SidebarRow {
                    x: Theme.spacing-sm;
                    width: parent.width - Theme.spacing-sm * 2;
                    height: parent.height;
                    label: row.label;
                    symbol: row.symbol;
                    selected: row.tab == root.selected-tab;
                    focus-generation: root.focus-generation;
                    clicked => { root.tab-selected(row.tab); }
                }
            }
        }

        Scrollbar {
            x: parent.width - Theme.size-scrollbar-inset - self.width;
            y: Theme.size-scrollbar-inset;
            height: parent.height - Theme.size-scrollbar-inset * 2;
            content-height: sidebar.content-height;
            viewport-height: sidebar.height;
            // content-y is negative while scrolled down; the rail wants a
            // positive offset.
            offset: -sidebar.content-y;
        }
    }

    // The 1 px rule sits inside the sidebar, so the detail column starts at 215.
    Rectangle {
        x: Theme.size-settings-sidebar - Theme.size-hairline;
        y: 0;
        width: Theme.size-hairline;
        height: root.height;
        background: Theme.separator;
    }

    Rectangle {
        x: Theme.size-settings-sidebar;
        y: 0;
        width: root.width - Theme.size-settings-sidebar;
        height: root.height;
        background: Theme.settings-detail;
        clip: true;

        // All five pages stay instantiated so each keeps its scroll position
        // when the tab changes; the hidden ones are skipped by Tab.
        RowsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 0;
            heading: root.general-heading;
            rows: root.general-rows;
            row-activated(id) => { root.general-row-activated(id); }
        }

        RowsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 1;
            heading: root.permissions-heading;
            rows: root.permissions-rows;
            row-activated(id) => { root.permissions-row-activated(id); }
        }

        RowsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 3;
            heading: root.backup-heading;
            rows: root.backup-rows;
            footnote: root.backup-footnote;
            row-activated(id) => { root.backup-row-activated(id); }
        }

        AboutPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 2;
            heading: root.about-heading;
            product: root.about-product;
            version: root.about-version;
            tagline: root.about-tagline;
            heart: root.about-heart;
            rows: root.about-rows;
            disclosure-title: root.about-disclosure-title;
            disclosure-note: root.about-disclosure-note;
            disclosure-link: root.about-disclosure-link;
            copyright: root.about-copyright;
            row-activated(id) => { root.about-row-activated(id); }
            link-clicked => { root.slint-link-clicked(); }
        }

        PlaceholderPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 4;
            heading: root.placeholder-heading;
            note: root.placeholder-note;
        }
    }
}
