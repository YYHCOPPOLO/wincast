// The settings window: a native-framed 900 × 700 page. The sidebar and the
// detail column share the page fill; cards are surface.
//
// The sidebar is built from tinycast_pure::layout::settings::sidebar_rows, so
// the 22 DIP section headers, 32 DIP tab rows and the 215 DIP column are the
// same geometry the Direct2D window used. Both columns scroll; Slint reveals
// the focused row inside its Flickable on its own.
import { Theme } from "../theme.slint";
import { Scrollbar } from "../primitives/scrollbar.slint";
import { SettingsRow, SidebarRow } from "../primitives/form.slint";
import { Checkbox } from "../primitives/checkbox.slint";
import { RecorderBubble } from "../primitives/recorder.slint";
import { MagEmptyState, MagHeader, MagInput } from "../primitives/magpie.slint";

// One row of the sidebar: kind 0 is a section header, kind 1 a SettingsTab.
// tab carries the SettingsTab discriminant; headers use -1.
export struct SettingsSidebarRow {
    kind: int,
    top: length,
    height: length,
    label: string,
    symbol: string,
    tab: int,
}

// One row of a settings page. id is the action the host runs.
// control: 0 plain action row, 1 switch, 2 trailing label, 3 shortcut well,
// 4 value select button, 5 single-line input, 6 status badge, 7 trailing
// destructive text button.
export struct SettingsPageRow {
    id: int,
    title: string,
    subtitle: string,
    trailing: string,
    control: int,
    checked: bool,
    active: bool,
    enabled: bool,
    tone: int,
    placeholder: string,
}

// One titled group of rows: the small spaced header, then one surface card
// whose rows are separated by 1 px rules, then the group's footer note.
export struct SettingsPageSection {
    title: string,
    note: string,
    rows: [SettingsPageRow],
}

// One surface card whose rows are separated by 1 px rules (magpie `.list`).
// Shared by every page that shows action rows.
component RowCard inherits Rectangle {
    in property <[SettingsPageRow]> rows;
    callback row-activated(int);
    callback row-trailing-activated(int);
    callback row-text-edited(int, string);
    callback row-text-accepted(int);
    callback row-well-revealed(length, length);

    background: Theme.card-fill;
    border-width: Theme.size-hairline;
    border-color: Theme.card-stroke;
    border-radius: Theme.radius-magpie-card;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        for row[i] in root.rows: Rectangle {
            height: Theme.size-settings-row-height;
            background: transparent;

            if i > 0: Rectangle {
                y: 0;
                height: Theme.size-hairline;
                background: Theme.separator;
            }

            SettingsRow {
                y: Theme.size-hairline;
                width: parent.width;
                height: parent.height - Theme.size-hairline;
                title: row.title;
                subtitle: row.subtitle;
                trailing: row.trailing;
                control: row.control;
                checked: row.checked;
                active: row.active;
                tone: row.tone;
                placeholder: row.placeholder;
                enabled: row.enabled;
                activated => { root.row-activated(row.id); }
                well-revealed(x, y) => { root.row-well-revealed(x, y); }
                trailing-activated => { root.row-trailing-activated(row.id); }
                text-edited(text) => { root.row-text-edited(row.id, text); }
                text-accepted(text) => { root.row-text-accepted(row.id); }
            }
        }
    }
}

// A heading plus titled surface cards of rows, scrolled as a whole. General,
// Permissions and Backup share it; 15 placeholder tabs do not use a card.
component RowsPage inherits Rectangle {
    in property <string> heading;
    in property <string> footnote;
    in property <[SettingsPageSection]> sections;
    callback row-activated(int);
    callback row-trailing-activated(int);
    callback row-text-edited(int, string);
    callback row-text-accepted(int);
    callback row-well-revealed(length, length);

    background: transparent;

    flick := Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        interactive: true;
        content-width: self.width;
        content-height: Math.max(self.height, body.height);

        body := Rectangle {
            width: parent.width;
            height: stack.preferred-height + Theme.spacing-xxl * 2;
            background: transparent;

            stack := VerticalLayout {
                x: Theme.spacing-xxl;
                y: Theme.spacing-xxl;
                width: parent.width - Theme.spacing-xxl * 2;
                spacing: Theme.spacing-section;

                Text {
                    text: root.heading;
                    font-size: Theme.font-panel-title;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                for section in root.sections: VerticalLayout {
                    spacing: Theme.spacing-section-header-bottom;

                    if section.title != "": MagHeader {
                        text-label: section.title;
                    }

                    RowCard {
                        rows: section.rows;
                        row-activated(id) => { root.row-activated(id); }
                        row-trailing-activated(id) => { root.row-trailing-activated(id); }
                        row-text-edited(id, text) => { root.row-text-edited(id, text); }
                        row-text-accepted(id) => { root.row-text-accepted(id); }
                        row-well-revealed(x, y) => { root.row-well-revealed(x, y); }
                    }

                    if section.note != "": Text {
                        text: section.note;
                        font-size: Theme.font-chip;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }

                if root.footnote != "": Text {
                    text: root.footnote;
                    font-size: Theme.font-chip;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }
            }
        }
    }

    Scrollbar {
        x: parent.width - Theme.size-scrollbar-inset - self.width;
        y: Theme.size-scrollbar-inset;
        height: parent.height - Theme.size-scrollbar-inset * 2;
        content-height: flick.content-height;
        viewport-height: flick.height;
        offset: -flick.content-y;
    }
}

// About: the heart mark, product/version, the Support and About rows, and the
// Slint Royalty-free 2.0 disclosure the design requires. The std-widgets
// AboutSlint badge is not linked in this build, so the mark and version are
// text here instead of the SVG.
component AboutPage inherits Rectangle {
    in property <string> heading;
    in property <string> product;
    in property <string> version;
    in property <string> tagline;
    in property <string> heart;
    in property <[SettingsPageRow]> rows;
    in property <string> disclosure-title;
    in property <string> disclosure-note;
    in property <string> disclosure-link;
    in property <string> copyright;
    callback row-activated(int);
    callback link-clicked();

    background: transparent;

    flick := Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        interactive: true;
        content-width: self.width;
        content-height: Math.max(self.height, body.height);

        body := Rectangle {
            width: parent.width;
            height: stack.preferred-height + Theme.spacing-xxl * 2;
            background: transparent;

            stack := VerticalLayout {
                x: Theme.spacing-xxl;
                y: Theme.spacing-xxl;
                width: parent.width - Theme.spacing-xxl * 2;
                spacing: Theme.spacing-md;

                Text {
                    text: root.heading;
                    font-size: Theme.font-panel-title;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                Text {
                    text: root.heart;
                    font-family: "Segoe Fluent Icons";
                    font-size: Theme.size-dialog-symbol-container;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.product;
                    font-size: Theme.font-row;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.version;
                    font-size: Theme.font-section;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.tagline;
                    font-size: Theme.font-section;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    background: Theme.card-fill;
                    border-width: Theme.size-hairline;
                    border-color: Theme.card-stroke;
                    border-radius: Theme.radius-magpie-card;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        for row[i] in root.rows: Rectangle {
                            height: Theme.size-settings-row-height;
                            background: transparent;

                            if i > 0: Rectangle {
                                y: 0;
                                height: Theme.size-hairline;
                                background: Theme.separator;
                            }

                            SettingsRow {
                                y: Theme.size-hairline;
                                width: parent.width;
                                height: parent.height - Theme.size-hairline;
                                title: row.title;
                                subtitle: row.subtitle;
                                trailing: row.trailing;
                                control: row.control;
                                checked: row.checked;
                                active: row.active;
                                enabled: row.enabled;
                                activated => { root.row-activated(row.id); }
                            }
                        }
                    }
                }

                Rectangle {
                    background: Theme.card-fill;
                    border-width: Theme.size-hairline;
                    border-color: Theme.card-stroke;
                    border-radius: Theme.radius-magpie-card;

                    VerticalLayout {
                        padding: Theme.spacing-xl;
                        spacing: Theme.spacing-sm;

                        Text {
                            text: root.disclosure-title;
                            font-size: Theme.font-section;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }

                        Text {
                            text: root.disclosure-note;
                            font-size: Theme.font-row;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        SettingsRow {
                            title: root.disclosure-link;
                            control: 0;
                            activated => { root.link-clicked(); }
                        }
                    }
                }

                Text {
                    text: root.copyright;
                    font-size: Theme.font-section;
                    color: Theme.text-tertiary;
                    horizontal-alignment: center;
                }
            }
        }
    }

    Scrollbar {
        x: parent.width - Theme.size-scrollbar-inset - self.width;
        y: Theme.size-scrollbar-inset;
        height: parent.height - Theme.size-scrollbar-inset * 2;
        content-height: flick.content-height;
        viewport-height: flick.height;
        offset: -flick.content-y;
    }
}

// One sliced row of the launcher pages: name, inline alias, the hotkey well
// and the visibility checkbox. `index` is the position in the host's filtered
// list (the slice only carries the visible rows); `top` places the row inside
// the scrolling container.
export struct LauncherItemRow {
    index: int,
    top: length,
    height: length,
    name: string,
    alias: string,
    hotkey: string,
    visible: bool,
    recording: bool,
    has-hotkey: bool,
}

// Applications, System Settings, System Actions and Commands: the enable
// switch, the filter, and the alias/visibility/hotkey table. The list keeps a
// visible slice in the model while the host owns the full count, exactly like
// the palette list.
component LauncherItemsPage inherits Rectangle {
    in property <string> heading;
    in property <[SettingsPageSection]> intro;
    in property <string> enable-title;
    in property <string> enable-subtitle;
    in property <bool> kind-on;
    in property <string> filter-hint;
    in-out property <string> filter-text;
    in property <[LauncherItemRow]> items;
    in property <length> items-content-height;
    in property <string> empty-label;
    in property <string> alias-hint;
    // The alias editor overlays the active row: -1 hides it. The column is
    // fixed for every row, so x comes from the page geometry and only y is
    // the active row's top.
    in property <int> alias-active: -1;
    in property <length> alias-y: 0px;
    in-out property <string> alias-text;
    in-out property <length> list-scroll: 0px;
    callback intro-activated(int);
    callback enable-toggled(bool);
    callback item-toggled(int);
    callback alias-activated(int);
    callback alias-edited(int, string);
    callback alias-committed(int);
    callback hotkey-clicked(int, length, length);
    callback filter-changed(string);
    callback list-scrolled();

    changed list-scroll => { root.list-scrolled(); }

    background: transparent;

    VerticalLayout {
        x: Theme.spacing-xxl;
        y: Theme.spacing-xxl;
        width: parent.width - Theme.spacing-xxl * 2;
        height: parent.height - Theme.spacing-xxl * 2;
        spacing: Theme.spacing-section;

        Text {
            text: root.heading;
            font-size: Theme.font-panel-title;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
        }

        for section in root.intro: VerticalLayout {
            spacing: Theme.spacing-section-header-bottom;

            if section.title != "": MagHeader {
                text-label: section.title;
            }

            RowCard {
                rows: section.rows;
                row-activated(id) => { root.intro-activated(id); }
            }

            if section.note != "": Text {
                text: section.note;
                font-size: Theme.font-chip;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }

        Rectangle {
            background: Theme.card-fill;
            border-width: Theme.size-hairline;
            border-color: Theme.card-stroke;
            border-radius: Theme.radius-magpie-card;
            clip: true;

            SettingsRow {
                width: 100%;
                height: Theme.size-settings-row-height;
                title: root.enable-title;
                subtitle: root.enable-subtitle;
                control: 1;
                checked: root.kind-on;
                activated => { root.enable-toggled(!root.kind-on); }
            }
        }

        list-card := Rectangle {
            vertical-stretch: 1;
            background: Theme.card-fill;
            border-width: Theme.size-hairline;
            border-color: Theme.card-stroke;
            border-radius: Theme.radius-magpie-card;
            clip: true;

            list-flick := Flickable {
                x: 0;
                y: Theme.size-settings-row-height;
                width: 100%;
                height: parent.height - Theme.size-settings-row-height;
                interactive: true;
                content-width: self.width;
                content-height: Math.max(self.height, root.items-content-height);
                content-y <=> root.list-scroll;

                Rectangle {
                    width: parent.width;
                    height: Math.max(list-flick.height, root.items-content-height);
                    background: transparent;

                    for item in root.items: Rectangle {
                        x: 0;
                        y: item.top;
                        width: parent.width;
                        height: item.height;
                        background: item-touch.has-hover ? Theme.row-hover : transparent;

                        if item.top > 0: Rectangle {
                            y: 0;
                            height: Theme.size-hairline;
                            background: Theme.separator;
                        }

                        item-touch := TouchArea {
                            clicked => {
                                if root.alias-active >= 0 {
                                    root.alias-committed(-1);
                                }
                            }
                        }

                        Text {
                            x: Theme.spacing-xl;
                            width: root.alias-column-x - Theme.spacing-xl - Theme.spacing-md;
                            height: parent.height;
                            text: item.name;
                            font-size: Theme.font-row;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if item.index != root.alias-active: Text {
                            x: root.alias-column-x;
                            width: Theme.size-shortcut-recorder;
                            height: parent.height;
                            text: item.alias == "" ? root.alias-hint : item.alias;
                            font-size: Theme.font-row-trailing;
                            color: item.alias == "" ? Theme.faint : Theme.fg-2;
                            vertical-alignment: center;
                            overflow: elide;

                            alias-touch := TouchArea {
                                clicked => { root.alias-activated(item.index); }
                            }
                        }

                        if item.has-hotkey: well := Rectangle {
                            x: root.hotkey-column-x;
                            width: Theme.size-shortcut-recorder;
                            height: Theme.size-magpie-field;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-magpie-control;
                            background: well-touch.has-hover ? Theme.pill-hover : Theme.surface;
                            border-width: Theme.size-hairline;
                            border-color: item.recording ? Theme.accent : Theme.border;

                            well-touch := TouchArea {
                                clicked => {
                                    root.hotkey-clicked(
                                        item.index,
                                        well.absolute-position.x + well.width / 2,
                                        well.absolute-position.y,
                                    );
                                }
                            }

                            Text {
                                x: Theme.spacing-xs;
                                width: parent.width - Theme.spacing-xs * 2;
                                height: parent.height;
                                text: item.hotkey;
                                font-size: Theme.font-chip;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Checkbox {
                            x: parent.width - Theme.spacing-xl - self.width;
                            y: (parent.height - self.height) / 2;
                            checked: item.visible;
                            toggled => { root.item-toggled(item.index); }
                        }
                    }

                    // The one alias editor, parked over the row being edited —
                    // the same single-field arrangement the Direct2D window
                    // used, so a scroll or re-filter never strands a draft.
                    // Creation is the open event, so `init` takes the keyboard.
                    if root.alias-active >= 0: MagInput {
                        x: root.alias-column-x;
                        y: root.alias-y + (Theme.size-settings-row-height - self.height) / 2;
                        width: Theme.size-shortcut-recorder;
                        text-value <=> root.alias-text;
                        placeholder: root.alias-hint;
                        edited(text) => { root.alias-edited(root.alias-active, text); }
                        accepted(text) => { root.alias-committed(root.alias-active); }
                        focus-lost => { root.alias-committed(root.alias-active); }
                        init => { self.focus-field(); }
                    }
                }
            }

            // The filter rides on top of the list card.
            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: Theme.size-settings-row-height;
                background: Theme.card-fill;

                Rectangle {
                    y: parent.height - Theme.size-hairline;
                    height: Theme.size-hairline;
                    width: 100%;
                    background: Theme.separator;
                }

                MagInput {
                    x: Theme.spacing-xl;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - Theme.spacing-xl * 2 - Theme.spacing-xxxl;
                    placeholder: root.filter-hint;
                    text-value <=> root.filter-text;
                    edited(text) => { root.filter-changed(text); }
                }
            }

            if root.items-content-height <= 0px: MagEmptyState {
                y: Theme.size-settings-row-height;
                width: 100%;
                height: parent.height - Theme.size-settings-row-height;
                label: root.empty-label;
            }

            Scrollbar {
                x: parent.width - Theme.size-scrollbar-inset - self.width;
                y: Theme.size-settings-row-height + Theme.size-scrollbar-inset;
                height: parent.height - Theme.size-settings-row-height
                    - Theme.size-scrollbar-inset * 2;
                content-height: Math.max(list-flick.height, root.items-content-height);
                viewport-height: list-flick.height;
                offset: -root.list-scroll;
            }
        }
    }

    // Trailing columns, right to left: checkbox, optional well, alias. Fixed
    // widths keep every column on one vertical line down the list. The origin
    // is the list card, whose contents the rows share.
    out property <length> alias-column-x: list-card.width - Theme.spacing-xl
        - Theme.size-checkbox - Theme.spacing-md
        - Theme.size-shortcut-recorder - Theme.spacing-md
        - Theme.size-shortcut-recorder;
    out property <length> hotkey-column-x: list-card.width - Theme.spacing-xl
        - Theme.size-checkbox - Theme.spacing-md
        - Theme.size-shortcut-recorder;
}

// The tabs still waiting for their phase-8 page: the tab title and one neutral
// i18n line, no fake controls.
component PlaceholderPage inherits Rectangle {
    in property <string> heading;
    in property <string> note;

    background: transparent;

    VerticalLayout {
        x: Theme.spacing-xxl;
        y: Theme.spacing-xxl;
        width: parent.width - Theme.spacing-xxl * 2;
        spacing: Theme.spacing-md;
        alignment: start;

        Text {
            text: root.heading;
            font-size: Theme.font-panel-title;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
        }

        Text {
            text: root.note;
            font-size: Theme.font-row;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}

export component SettingsWindow inherits Window {
    in property <string> window-title;
    in property <[SettingsSidebarRow]> sidebar-rows;
    in property <length> sidebar-content-height: 0px;
    // The host keeps the selected tab on screen when Settings opens or the tab
    // changes; the wheel and keyboard still move it after that.
    in-out property <length> sidebar-scroll: 0px;
    // The SettingsTab discriminant AppCore selected; the only selection source.
    in property <int> selected-tab: 0;
    // 0 General, 1 Permissions, 2 About, 3 Backup, 4 launcher items,
    // 5 feature rows, 6 the placeholder tabs.
    in property <int> page-kind: 0;
    in property <[SettingsPageSection]> general-sections;
    in property <[SettingsPageSection]> permissions-sections;
    in property <[SettingsPageSection]> backup-sections;
    in property <[SettingsPageRow]> about-rows;
    in property <string> general-heading;
    in property <string> permissions-heading;
    in property <string> backup-heading;
    in property <string> backup-footnote;
    in property <string> about-heading;
    in property <string> about-product;
    in property <string> about-version;
    in property <string> about-tagline;
    in property <string> about-heart;
    in property <string> about-disclosure-title;
    in property <string> about-disclosure-note;
    in property <string> about-disclosure-link;
    in property <string> about-copyright;
    in property <string> placeholder-heading;
    in property <string> placeholder-note;
    // The launcher pages (Applications, System Settings, System Actions and
    // Commands share one instance; the host re-slices the list per tab).
    in property <string> launcher-heading;
    in property <[SettingsPageSection]> launcher-intro;
    in property <string> launcher-enable-title;
    in property <string> launcher-enable-subtitle;
    in property <bool> launcher-kind-on;
    in property <string> launcher-filter-hint;
    in-out property <string> launcher-filter-text;
    in property <[LauncherItemRow]> launcher-items;
    in property <length> launcher-items-height;
    in property <string> launcher-empty;
    in property <string> launcher-alias-hint;
    in property <int> launcher-alias-active: -1;
    in property <length> launcher-alias-y: 0px;
    in-out property <string> launcher-alias-text;
    in-out property <length> launcher-list-scroll: 0px;
    // The feature rows page (Quicklinks in 8.1; the other feature tabs in 8.2).
    in property <string> feature-heading;
    in property <[SettingsPageSection]> feature-sections;

    callback tab-selected(int);
    callback general-row-activated(int);
    callback permissions-row-activated(int);
    callback backup-row-activated(int);
    callback about-row-activated(int);
    callback slint-link-clicked();
    callback launcher-intro-activated(int);
    callback launcher-enable-toggled(bool);
    callback launcher-item-toggled(int);
    callback launcher-alias-activated(int);
    callback launcher-alias-edited(int, string);
    callback launcher-alias-committed(int);
    callback launcher-hotkey-clicked(int, length, length);
    callback launcher-filter-changed(string);
    callback launcher-list-scrolled();
    callback feature-row-activated(int);
    callback feature-trailing-activated(int);
    callback feature-text-edited(int, string);
    callback feature-text-accepted(int);
    // The recorder callout: the rows report the well's window position.
    in property <bool> recorder-visible: false;
    in property <length> recorder-x: 0px;
    in property <length> recorder-y: 0px;
    in property <[string]> recorder-keys;
    in property <string> recorder-caption;
    in property <string> recorder-esc;
    callback general-well-revealed(length, length);

    // Bumped when the keyboard should land on the selected tab (on show).
    private property <int> focus-generation: 0;

    title: root.window-title;
    // Initial size; the old window could be resized, so it is a preferred size
    // plus the minimum the old WM_GETMINMAXINFO enforced.
    preferred-width: Theme.size-settings-window-width;
    preferred-height: Theme.size-settings-window-height;
    min-width: Theme.size-settings-sidebar + Theme.size-settings-detail-minimum;
    min-height: Theme.size-settings-window-height;
    background: Theme.page;
    default-font-family: "Segoe UI";
    default-font-size: Theme.font-row;

    public function focus-selected-tab() {
        root.focus-generation += 1;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: Theme.size-settings-sidebar;
        height: root.height;
        background: Theme.settings-sidebar;
        clip: true;

        sidebar := Flickable {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            interactive: true;
            content-width: self.width;
            content-height: Math.max(self.height, root.sidebar-content-height);
            content-y <=> root.sidebar-scroll;

            for row in root.sidebar-rows: Rectangle {
                x: 0;
                y: row.top;
                width: 100%;
                height: row.height;
                background: transparent;

                if row.kind == 0: MagHeader {
                    x: Theme.spacing-xl;
                    width: parent.width - Theme.spacing-xl - Theme.spacing-md;
                    height: parent.height;
                    text-label: row.label;
                    vertical-alignment: center;
                }

                if row.kind == 1: SidebarRow {
                    x: Theme.spacing-sm;
                    width: parent.width - Theme.spacing-sm * 2;
                    height: parent.height;
                    label: row.label;
                    symbol: row.symbol;
                    selected: row.tab == root.selected-tab;
                    focus-generation: root.focus-generation;
                    clicked => { root.tab-selected(row.tab); }
                }
            }
        }

    }

    // The 1 px rule sits inside the sidebar, so the detail column starts at 215.
    Rectangle {
        x: Theme.size-settings-sidebar - Theme.size-hairline;
        y: 0;
        width: Theme.size-hairline;
        height: root.height;
        background: Theme.separator;
    }

    Rectangle {
        x: Theme.size-settings-sidebar;
        y: 0;
        width: root.width - Theme.size-settings-sidebar;
        height: root.height;
        background: Theme.settings-detail;
        clip: true;

        // All five pages stay instantiated so each keeps its scroll position
        // when the tab changes; the hidden ones are skipped by Tab.
        RowsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 0;
            heading: root.general-heading;
            sections: root.general-sections;
            row-activated(id) => { root.general-row-activated(id); }
            row-well-revealed(x, y) => { root.general-well-revealed(x, y); }
        }

        RowsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 1;
            heading: root.permissions-heading;
            sections: root.permissions-sections;
            row-activated(id) => { root.permissions-row-activated(id); }
        }

        RowsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 3;
            heading: root.backup-heading;
            sections: root.backup-sections;
            footnote: root.backup-footnote;
            row-activated(id) => { root.backup-row-activated(id); }
        }

        AboutPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 2;
            heading: root.about-heading;
            product: root.about-product;
            version: root.about-version;
            tagline: root.about-tagline;
            heart: root.about-heart;
            rows: root.about-rows;
            disclosure-title: root.about-disclosure-title;
            disclosure-note: root.about-disclosure-note;
            disclosure-link: root.about-disclosure-link;
            copyright: root.about-copyright;
            row-activated(id) => { root.about-row-activated(id); }
            link-clicked => { root.slint-link-clicked(); }
        }

        launcher-page := LauncherItemsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 4;
            heading: root.launcher-heading;
            intro: root.launcher-intro;
            enable-title: root.launcher-enable-title;
            enable-subtitle: root.launcher-enable-subtitle;
            kind-on: root.launcher-kind-on;
            filter-hint: root.launcher-filter-hint;
            filter-text <=> root.launcher-filter-text;
            items: root.launcher-items;
            items-content-height: root.launcher-items-height;
            empty-label: root.launcher-empty;
            alias-hint: root.launcher-alias-hint;
            alias-active: root.launcher-alias-active;
            alias-y: root.launcher-alias-y;
            alias-text <=> root.launcher-alias-text;
            list-scroll <=> root.launcher-list-scroll;
            intro-activated(id) => { root.launcher-intro-activated(id); }
            enable-toggled(on) => { root.launcher-enable-toggled(on); }
            item-toggled(index) => { root.launcher-item-toggled(index); }
            alias-activated(index) => { root.launcher-alias-activated(index); }
            alias-edited(index, text) => { root.launcher-alias-edited(index, text); }
            alias-committed(index) => { root.launcher-alias-committed(index); }
            hotkey-clicked(index, x, y) => { root.launcher-hotkey-clicked(index, x, y); }
            filter-changed(text) => { root.launcher-filter-changed(text); }
            list-scrolled => { root.launcher-list-scrolled(); }
        }

        RowsPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 5;
            heading: root.feature-heading;
            sections: root.feature-sections;
            row-activated(id) => { root.feature-row-activated(id); }
            row-trailing-activated(id) => { root.feature-trailing-activated(id); }
            row-text-edited(id, text) => { root.feature-text-edited(id, text); }
            row-text-accepted(id) => { root.feature-text-accepted(id); }
        }

        PlaceholderPage {
            width: 100%;
            height: 100%;
            visible: root.page-kind == 6;
            heading: root.placeholder-heading;
            note: root.placeholder-note;
        }
    }

    // The recorder callout floats above the listening well; the caret's tip
    // touches the well's top edge and the bubble stays inside the window.
    if root.recorder-visible: RecorderBubble {
        x: Math.max(
            Theme.spacing-md,
            Math.min(root.recorder-x - self.width / 2, root.width - self.width
                - Theme.spacing-md),
        );
        y: Math.max(
            Theme.spacing-md,
            root.recorder-y - self.height + Theme.size-callout-caret-height,
        );
        keys: root.recorder-keys;
        caption: root.recorder-caption;
        esc-label: root.recorder-esc;
        reveal: true;
    }
}