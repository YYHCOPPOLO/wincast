// The command palette. The flat surface, the header, the rows and the chrome
// are Slint; the search field itself is a native EDIT child the host parents to
// this window. That child paints its own opaque field and empty-field hint.
import { Theme, Motion } from "../theme.slint";
import { GlyphIcon } from "../primitives/icons.slint";
import { Panel } from "../primitives/panel.slint";
import { Menu, MenuItem } from "../primitives/menu.slint";
import { Keycap } from "../primitives/keycap.slint";
import { Row, SectionHeader } from "../primitives/row.slint";
import { Scrollbar } from "../primitives/scrollbar.slint";
import { Footer } from "../primitives/footer.slint";

// Row kinds shared with crates/tinycast/src/ui_host/snapshot.rs.
// 0 result row, 1 section header, 2 calculator card, 3 emoji row.
export struct PaletteRow {
    kind: int,
    title: string,
    trailing: string,
    keycap: string,
    symbol: string,
    alias: string,
    expression: string,
    badge-left: string,
    badge-right: string,
    is-error: bool,
    glyphs: [string],
    columns: int,
    emoji-start: int,
    emoji-selected: int,
    checkbox: int,
    icon: image,
    icon-ready: bool,
    // A tall clipboard image row: the leading slot draws the 52 DIP thumbnail
    // instead of the 26 DIP glyph.
    image-row: bool,
    selected: bool,
    top: length,
    height: length,
}

// AI transcript rows, built by crates/tinycast/src/ui_host/snapshot.rs.
// 0 user bubble, 1 assistant text, 2 notice line. top/height come from
// tinycast_pure::layout::list, the same functions AppCore clamps the wheel with.
export struct ChatRow {
    role: int,
    text: string,
    failed: bool,
    streaming: bool,
    top: length,
    height: length,
}

// One chip under the dictionary headword; tone 0 neutral, 1 accent, 2 amber
// (`tinycast_pure::dictionary::BadgeTone`).
export struct DictionaryBadge {
    text: string,
    tone: int,
}

// One row of the dictionary page. Kind 0 section title, 1 Chinese line,
// 2 English line, 3 form row, 4 parts of speech, 5 frequency pill, 6 note
// (`tinycast_pure::dictionary::DictionaryRowKind`). `gap` is the extra space
// above the row in DIP; only a section title after the first carries one.
export struct DictionaryRow {
    kind: int,
    label: string,
    text: string,
    gap: length,
}

// A badge under one calculator column: 11 DIP ink on controlSurface.
component CalcBadge inherits Rectangle {
    in property <string> text;

    height: Theme.font-calc-badge + Theme.spacing-xs;
    // A bare Rectangle has no preferred width; the label measures the pill.
    width: badge-label.width + Theme.spacing-sm * 2;
    border-radius: Theme.radius-key-cap;
    background: Theme.control-surface;

    badge-label := Text {
        x: Theme.spacing-sm;
        y: 0;
        height: parent.height;
        text: root.text;
        font-family: "Segoe UI";
        font-size: Theme.font-calc-badge;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

// One side of the answer card: the value line and, under it, its kind pill.
// The pill sits in a full-width holder instead of the column's layout: a layout
// child with an explicit width becomes the column's maximum, and the badge's
// label-measured width capped both columns so every value elided.
component CalcColumn inherits Rectangle {
    in property <string> value;
    in property <string> badge;
    in property <int> weight: 500;

    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: Theme.spacing-md;

        Text {
            width: 100%;
            min-width: 0px;
            text: root.value;
            font-family: "Segoe UI";
            font-size: Theme.font-calc-result;
            font-weight: root.weight;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.badge != "": Rectangle {
            height: Theme.font-calc-badge + Theme.spacing-xs;
            background: transparent;

            CalcBadge {
                x: (parent.width - self.width) / 2;
                y: 0;
                text: root.badge;
            }
        }
    }
}

// One 96 DIP answer card: expression to result, or a triangle and the message.
// Two columns share the card; the 22 DIP arrows is the only fixed slot between.
component CalcCard inherits Rectangle {
    in property <string> expression;
    in property <string> display;
    in property <string> badge-left;
    in property <string> badge-right;
    in property <string> error-symbol;
    in property <string> arrow-symbol;
    in property <bool> is-error: false;
    in property <bool> selected: false;
    // The host computes the hover (pointer position over the slice), so a
    // rebuild cannot leave a stale delegate hover on the wrong row.
    in property <bool> hovered: false;
    // The list column width; a component cannot read its parent.
    in property <length> slot-width;

    callback clicked(length, length);

    x: Theme.spacing-xl;
    y: 0;
    width: root.slot-width - Theme.spacing-xl * 2;
    height: Theme.size-calc-card-height;
    border-radius: Theme.radius-card;
    // On the now-opaque surface a plain cardFill would be the same white as the
    // panel; the 1 px border keeps the tile visible, like every other card.
    background: root.selected ? Theme.selection
        : (root.hovered ? Theme.row-hover : Theme.card-fill);
    border-width: Theme.size-hairline;
    border-color: Theme.card-stroke;

    if root.is-error: HorizontalLayout {
        width: 100%;
        height: 100%;
        // The error line starts where a column's text starts (old inner.x = 24).
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        spacing: Theme.spacing-md;

        VerticalLayout {
            alignment: center;

            GlyphIcon {
                size: Theme.font-header-icon + 3px;
                name: root.error-symbol;
            }
        }

        Text {
            text: root.display;
            font-family: "Segoe UI";
            font-size: Theme.font-row;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    if !root.is-error: HorizontalLayout {
        width: 100%;
        height: 100%;
        // 16 DIP above and below leaves the 22 DIP line and the pill room to
        // breathe inside the 96 DIP card instead of overflowing its 40 DIP core.
        padding-top: Theme.spacing-md * 2;
        padding-bottom: Theme.spacing-md * 2;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        spacing: Theme.spacing-sm;

        CalcColumn {
            horizontal-stretch: 1;
            value: root.expression;
            badge: root.badge-left;
            weight: 500;
        }

        VerticalLayout {
            alignment: center;

            GlyphIcon {
                size: Theme.font-header-icon + 3px;
                name: root.arrow-symbol;
                ink: Theme.text-tertiary;
            }
        }

        CalcColumn {
            horizontal-stretch: 1;
            value: root.display;
            badge: root.badge-right;
            weight: 600;
        }
    }

    card-touch := TouchArea {
        clicked => {
            root.clicked(
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y,
            );
        }
    }
}

// One 56 DIP emoji grid row. 56 is the cell HEIGHT (tinycast_pure::emoji::CELL_DIP,
// the same slot height the Direct2D row used); the width is the list width divided
// by the model's column count, exactly what emoji::hit_index maps pointer x with.
// The selected cell gets a 2 DIP border and the glyph keeps every colour
// (Segoe UI Emoji is COLR, so no tint is applied).
component EmojiGridRow inherits Rectangle {
    in property <[string]> glyphs;
    in property <int> columns: 8;
    in property <int> start;
    in property <int> selected;
    in property <bool> hover-armed: false;

    callback clicked(length, length);

    height: Theme.size-emoji-cell;
    background: transparent;
    property <length> cell-width: self.width / Math.max(1, root.columns);

    for glyph[k] in root.glyphs: Rectangle {
        x: k * root.cell-width;
        y: 0;
        width: root.cell-width;
        height: root.height;
        background: transparent;

        Rectangle {
            x: Theme.size-hairline * 2;
            y: Theme.size-hairline * 2;
            width: parent.width - Theme.size-hairline * 4;
            height: parent.height - Theme.size-hairline * 4;
            border-radius: Theme.radius-emoji-cell;
            background: root.start + k == root.selected ? Theme.selection : Theme.emoji-cell;
            border-width: (root.start + k == root.selected)
                || (root.hover-armed && cell-touch.has-hover)
                ? Theme.size-hairline * 2 : 0px;
            border-color: root.start + k == root.selected
                ? Theme.emoji-selection-border : Theme.emoji-hover-border;
        }

        Text {
            text: glyph;
            font-family: "Segoe UI Emoji";
            font-size: Theme.font-emoji;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        cell-touch := TouchArea {
            clicked => {
                root.clicked(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }
}

// The clipboard type filter in the header's trailing slot.
component FilterButton inherits Rectangle {
    in property <string> label;
    in property <bool> open: false;

    callback clicked;

    border-radius: Theme.radius-bar-control;
    background: root.open ? Theme.selection
        : (filter-touch.has-hover ? Theme.control-hover : Theme.control-surface);

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;

        Text {
            text: root.label;
            font-family: "Segoe UI";
            font-size: Theme.font-row-trailing;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    filter-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One transcript block. The host owns the row's top and height, so a block is
// placed like any other palette slot: user on the right in a controlSurface
// bubble, the assistant's plain text at the 20 DIP transcript gutter, and a
// secondary notice line under the last reply.
component ChatLine inherits Rectangle {
    in property <int> role;
    in property <string> text;
    in property <bool> failed: false;
    in property <bool> streaming: false;
    // "Thinking" while a reply streams with no text yet; the host's i18n copy,
    // never an English literal here.
    in property <string> thinking-label;
    // The transcript column width; a component cannot read its parent.
    in property <length> slot-width;

    property <string> display: root.role == 1 && root.streaming && root.text == ""
        ? root.thinking-label : root.text;
    property <color> ink: root.failed ? Theme.destructive : Theme.text-primary;

    background: transparent;

    if root.role == 0: HorizontalLayout {
        alignment: end;
        // 20 DIP gutters: the bubble right edge sits where the assistant's
        // column starts, so a full-width bubble lines up with the plain text.
        padding-left: Theme.spacing-xxl;
        padding-right: Theme.spacing-xxl;

        bubble := Rectangle {
            max-width: root.slot-width - Theme.spacing-xxl * 2;
            border-radius: Theme.radius-row;
            background: Theme.control-surface;

            HorizontalLayout {
                padding-left: Theme.spacing-xl;
                padding-right: Theme.spacing-xl;
                padding-top: Theme.spacing-md;
                padding-bottom: Theme.spacing-md;

                Text {
                    text: root.display;
                    // A long unbroken token must still wrap inside the cap.
                    min-width: 0px;
                    wrap: word-wrap;
                    overflow: clip;
                    horizontal-alignment: right;
                    vertical-alignment: top;
                    font-family: "Segoe UI";
                    font-size: Theme.font-row;
                    color: root.ink;
                }
            }
        }
    }

    // The assistant has no bubble: 20 DIP gutter plus the 6 DIP text inset.
    if root.role == 1: Text {
        x: Theme.spacing-xxl + Theme.spacing-sm;
        y: Theme.spacing-md;
        width: root.slot-width - (Theme.spacing-xxl + Theme.spacing-sm) * 2;
        height: root.height - Theme.spacing-md * 2;
        text: root.display;
        wrap: word-wrap;
        overflow: clip;
        vertical-alignment: top;
        font-family: "Segoe UI";
        font-size: Theme.font-row;
        color: root.ink;
    }

    if root.role == 2: Text {
        x: Theme.spacing-xxl;
        y: 0;
        width: root.slot-width - Theme.spacing-xxl * 2;
        height: root.height;
        text: root.text;
        wrap: word-wrap;
        overflow: clip;
        vertical-alignment: top;
        font-family: "Segoe UI";
        font-size: Theme.font-row;
        color: Theme.text-secondary;
    }
}

// One chip under the dictionary headword: soft tile plus its matching ink.
// Tone comes from `tinycast_pure::dictionary::BadgeTone`.
component DictBadge inherits Rectangle {
    in property <string> text;
    in property <int> tone: 0;

    height: 20px;
    width: badge-text.preferred-width + Theme.spacing-md * 2;
    border-radius: Theme.radius-key-cap;
    background: root.tone == 2 ? Theme.amber-soft
        : root.tone == 1 ? Theme.accent-soft
        : Theme.control-surface;

    badge-text := Text {
        x: Theme.spacing-md;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        text: root.text;
        font-family: Theme.font-family;
        font-size: Theme.font-chip;
        font-weight: 500;
        color: root.tone == 2 ? Theme.amber
            : root.tone == 1 ? Theme.accent
            : Theme.fg-2;
        vertical-alignment: center;
    }
}

// A section title: the 2 x 11 accent bar, then the small caps label. The 14 DIP
// above a section after the first rides in this row's own height, so the body
// layout needs no spacer rows.
component DictSectionTitle inherits Rectangle {
    in property <string> text;
    in property <length> gap: 0px;

    background: transparent;
    height: root.gap + 16px;

    Rectangle {
        x: 0;
        y: root.gap + (16px - self.height) / 2;
        width: 2px;
        height: 11px;
        border-radius: 1px;
        background: Theme.accent;
    }

    Text {
        x: 2px + Theme.spacing-md;
        y: root.gap;
        width: parent.width - 2px - Theme.spacing-md;
        height: 16px;
        text: root.text;
        font-family: Theme.font-family;
        font-size: Theme.font-section;
        font-weight: 600;
        letter-spacing: 0.4px;
        color: Theme.text-tertiary;
        vertical-alignment: center;
    }
}

// One wrapped body line: a Chinese or English definition line, a parts-of-speech
// line or a note. The height carries the 3-4 DIP line rhythm.
component DictBodyLine inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-primary;
    in property <length> size: Theme.font-row;

    background: transparent;
    height: line.preferred-height + 3px;

    line := Text {
        x: Theme.spacing-lg;
        y: 0;
        width: parent.width - Theme.spacing-lg;
        height: self.preferred-height;
        text: root.text;
        wrap: word-wrap;
        font-family: Theme.font-family;
        font-size: root.size;
        color: root.ink;
    }
}

// One inflected form: the exchange label in a fixed 72 DIP column, the word
// beside it, both free to wrap.
component DictFormRow inherits Rectangle {
    in property <string> label;
    in property <string> text;

    background: transparent;
    height: Math.max(label-text.preferred-height, value-text.preferred-height)
        + 3px;

    label-text := Text {
        x: Theme.spacing-lg;
        y: 1px;
        width: 72px;
        height: self.preferred-height;
        text: root.label;
        wrap: word-wrap;
        font-family: Theme.font-family;
        font-size: Theme.font-section;
        color: Theme.text-tertiary;
        vertical-alignment: top;
    }

    value-text := Text {
        x: Theme.spacing-lg + 72px + Theme.spacing-sm;
        y: 0;
        width: parent.width - Theme.spacing-lg - 72px - Theme.spacing-sm;
        height: self.preferred-height;
        text: root.text;
        wrap: word-wrap;
        font-family: Theme.font-family;
        font-size: Theme.font-row;
        color: Theme.text-primary;
    }
}

// The frequency line: BNC and COCA ranks on one quiet pill.
component DictStatRow inherits Rectangle {
    in property <string> text;

    background: transparent;
    height: 24px + 3px;

    Rectangle {
        x: Theme.spacing-lg;
        y: 0;
        width: stat-text.preferred-width + Theme.spacing-md * 2;
        height: 24px;
        border-radius: Theme.radius-magpie-control;
        background: Theme.card-2;

        stat-text := Text {
            x: Theme.spacing-md;
            y: 0;
            width: self.preferred-width;
            height: parent.height;
            text: root.text;
            font-family: Theme.font-family;
            font-size: Theme.font-row-trailing;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }
}

// The entry card: headword, phonetic and badges, with the copy button and the
// corpus label in the trailing corner. It is never truncated: a long headword
// wraps and the card grows down instead of clipping.
component DictHeader inherits Rectangle {
    in property <string> word;
    in property <string> phonetic;
    in property <[DictionaryBadge]> badges;
    in property <string> source-label;
    callback copy-requested;

    // 14 DIP card padding and rail, 26 DIP copy target.
    private property <length> card-padding: 14px;
    private property <length> copy-size: 26px;
    private property <length> corner-width:
        root.copy-size + Theme.spacing-md + source-text.width;

    background: Theme.card-fill;
    border-width: Theme.size-hairline;
    border-color: Theme.card-stroke;
    border-radius: Theme.radius-magpie-card;
    height: badge-row.y + badge-row.height + root.card-padding;

    headword-text := Text {
        x: root.card-padding;
        y: root.card-padding;
        width: parent.width - root.card-padding * 2 - root.corner-width - Theme.spacing-md;
        height: self.preferred-height;
        text: root.word;
        wrap: word-wrap;
        font-family: Theme.font-family;
        font-size: Theme.font-calc-result;
        font-weight: 600;
        color: Theme.text-primary;
        vertical-alignment: top;
    }

    phonetic-text := Text {
        x: root.card-padding;
        y: headword-text.y + headword-text.height
            + (root.phonetic == "" ? 0px : Theme.spacing-xs);
        width: parent.width - root.card-padding * 2 - root.corner-width - Theme.spacing-md;
        height: root.phonetic == "" ? 0px : self.preferred-height;
        text: root.phonetic;
        font-family: Theme.font-family;
        font-size: Theme.font-row;
        color: Theme.text-secondary;
        vertical-alignment: top;
    }

    badge-row := Rectangle {
        x: root.card-padding;
        y: phonetic-text.y + phonetic-text.height
            + (root.badges.length == 0 ? 0px : Theme.spacing-lg);
        width: parent.width - root.card-padding * 2;
        height: root.badges.length == 0 ? 0px : 20px;
        background: transparent;
        // Eleven tags never fit one line on a narrow card: clip instead of
        // growing the card sideways.
        clip: true;

        HorizontalLayout {
            alignment: start;
            spacing: Theme.spacing-xs;

            for badge in root.badges: DictBadge {
                text: badge.text;
                tone: badge.tone;
            }
        }
    }

    source-text := Text {
        x: parent.width - root.card-padding - root.copy-size - Theme.spacing-md - self.width;
        y: root.card-padding;
        width: self.preferred-width;
        height: root.copy-size;
        text: root.source-label;
        font-family: Theme.font-family;
        font-size: 10px;
        letter-spacing: 0.5px;
        color: Theme.text-tertiary;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - root.card-padding - root.copy-size;
        y: root.card-padding;
        width: root.copy-size;
        height: root.copy-size;
        border-radius: Theme.radius-key-cap;
        background: copy-touch.has-hover ? Theme.row-hover : transparent;

        GlyphIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: 14px;
            name: "doc.on.clipboard";
            ink: Theme.text-tertiary;
        }

        copy-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.copy-requested(); }
        }
    }
}

// The panel before a lookup and after a miss: the page tile, a title, one line
// of help and, on a miss, the closest headwords. The block is centred while it
// fits and scrolls once eight suggestions outgrow the page, so it never clips.
component DictEmptyState inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> closest-label;
    in property <[string]> suggestions;

    background: transparent;

    empty-flick := Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        interactive: true;
        content-width: self.width;
        content-height: Math.max(
            self.height,
            empty-stack.preferred-height + Theme.spacing-xl * 2,
        );

        empty-stack := VerticalLayout {
            x: 0;
            y: Math.max(
                Theme.spacing-xl,
                (empty-flick.height - self.preferred-height) / 2,
            );
            width: parent.width;
            alignment: center;
            spacing: 0px;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: Theme.radius-menu-panel;
                    background: Theme.control-surface;

                    GlyphIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 28px;
                        name: "text.page";
                        ink: Theme.text-tertiary;
                    }
                }
            }

            Rectangle {
                height: Theme.spacing-md;
                background: transparent;
            }

            Text {
                text: root.title;
                font-family: Theme.font-family;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text-primary;
                horizontal-alignment: center;
                height: self.preferred-height;
            }

            Rectangle {
                height: Theme.spacing-sm;
                background: transparent;
            }

            Text {
                width: Math.min(parent.width - Theme.spacing-xxl * 2, 480px);
                height: self.preferred-height;
                text: root.body;
                wrap: word-wrap;
                font-family: Theme.font-family;
                font-size: Theme.font-row-trailing;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }

            if root.suggestions.length > 0: Rectangle {
                height: Theme.spacing-section;
                background: transparent;
            }

            if root.suggestions.length > 0: Text {
                text: root.closest-label;
                font-family: Theme.font-family;
                font-size: Theme.font-section;
                font-weight: 600;
                letter-spacing: 0.4px;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
                height: self.preferred-height;
            }

            for suggestion in root.suggestions: Text {
                text: suggestion;
                font-family: Theme.font-family;
                font-size: Theme.font-row;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                // A hair of air between lines: the list has no other rhythm.
                height: self.preferred-height + Theme.spacing-xxs;
            }
        }
    }
}

// The dictionary page: a fixed entry card over a scrolling body, or the empty
// and miss states. AppCore owns every string; this file owns the typography.
export component DictionaryPanel inherits Rectangle {
    in property <bool> has-entry: false;
    in property <string> word;
    in property <string> phonetic;
    in property <[DictionaryBadge]> badges;
    in property <[DictionaryRow]> rows;
    in property <string> empty-title;
    in property <string> empty-body;
    in property <[string]> suggestions;
    in property <string> closest-label;
    in property <string> source-label;
    in property <string> copied-label;
    in-out property <int> copy-token: 0;
    in-out property <length> scroll-y: 0px;
    callback copy-requested;

    private property <bool> toast-visible: false;
    // Spec insets: the 14 DIP card rail, 16 DIP body left and a 26 DIP right
    // rail for the scrollbar. The bottom is 12 rather than 18 so a short entry
    // (hello, a) fits without a rail; the last row already carries its own
    // line rhythm.
    private property <length> card-inset: 14px;
    private property <length> body-left: Theme.spacing-md * 2;
    private property <length> body-right: Theme.spacing-xxl + Theme.spacing-sm;
    private property <length> body-top: Theme.spacing-xl;
    private property <length> body-bottom: Theme.spacing-xl;
    // True once the rows really run past the viewport: the rail and the edge
    // dissolves both hang off it. A few DIP of layout slack (a trailing line
    // rhythm, the insets) must not look like a scrollable page.
    private property <bool> body-scrollable:
        body-flick.content-height > body-flick.height + 8px;

    background: transparent;

    // A new headword, or a new state, starts the page at the top. The offset is
    // mirrored through `scroll-y` so the rail and these resets agree.
    changed word => { root.scroll-y = 0px; }
    changed has-entry => { root.scroll-y = 0px; }
    // The token only grows once a copy landed, so a repaint cannot revive a
    // toast that already faded.
    changed copy-token => { root.toast-visible = true; }

    Timer {
        interval: 1400ms;
        running: root.toast-visible;
        triggered => { root.toast-visible = false; }
    }

    dict-card := DictHeader {
        x: root.card-inset;
        y: root.card-inset;
        width: root.width - root.card-inset * 2;
        visible: root.has-entry;
        word: root.word;
        phonetic: root.phonetic;
        badges: root.badges;
        source-label: root.source-label;
        copy-requested => { root.copy-requested(); }
    }

    // The body keeps the card fixed and scrolls the rows under it.
    Rectangle {
        x: 0;
        y: root.card-inset + dict-card.height + Theme.spacing-xl;
        width: 100%;
        height: Math.max(0px, root.height - self.y);
        background: transparent;
        visible: root.has-entry;
        clip: true;

        body-flick := Flickable {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            interactive: true;
            content-width: self.width;
            content-height: Math.max(
                self.height,
                body-stack.preferred-height + root.body-top + root.body-bottom,
            );
            // The flickable owns the wheel and drag offset; scroll-y mirrors it
            // for the rail, and writing scroll-y moves the page (word changes).
            changed content-y => { root.scroll-y = -self.content-y; }

            body-stack := VerticalLayout {
                x: root.body-left;
                y: root.body-top;
                width: body-flick.width - root.body-left - root.body-right;
                spacing: 0px;

                // One row slot per model row; the conditional child reports its
                // own height, so the slot is exactly as tall as the shape it
                // picked and the gap never needs a spacer.
                for row in root.rows: VerticalLayout {
                    spacing: 0px;

                    if row.kind == 0: DictSectionTitle {
                        text: row.text;
                        gap: row.gap;
                    }

                    if row.kind == 1: DictBodyLine {
                        text: row.text;
                        ink: Theme.text-primary;
                    }

                    if row.kind == 2: DictBodyLine {
                        text: row.text;
                        ink: Theme.fg-2;
                    }

                    if row.kind == 3: DictFormRow {
                        label: row.label;
                        text: row.text;
                    }

                    if row.kind == 4: DictBodyLine {
                        text: row.text;
                        ink: Theme.text-secondary;
                        size: Theme.font-row-trailing;
                    }

                    if row.kind == 5: DictStatRow {
                        text: row.text;
                    }

                    if row.kind == 6: DictBodyLine {
                        text: row.text;
                        ink: Theme.text-secondary;
                        size: Theme.font-row-trailing;
                    }
                }
            }
        }

        // Only a real overflow earns a rail: a few DIP of layout slack must not
        // look like a scrollable page.
        if root.body-scrollable: Scrollbar {
            x: parent.width - Theme.size-scrollbar-inset - self.width;
            y: 0;
            height: parent.height;
            content-height: body-flick.content-height;
            viewport-height: body-flick.height;
            offset: root.scroll-y;
            scroll-to(offset) => { root.scroll-y = offset; }
        }

        // The body's own dissolve: rows fade where they run out under the card
        // and above the footer. Plain rectangles, so the wheel and drag still
        // reach the flickable underneath. Each band only shows while there is
        // something hidden that way, so the first line is never dimmed.
        if root.body-scrollable && root.scroll-y > 0px: Rectangle {
            y: 0;
            width: 100%;
            height: 14px;
            background: @linear-gradient(
                180deg,
                Theme.surface 0%,
                Theme.surface.with-alpha(0) 100%,
            );
        }

        if root.body-scrollable
            && root.scroll-y < body-flick.content-height - body-flick.height - 1px: Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: 14px;
            background: @linear-gradient(
                180deg,
                Theme.surface.with-alpha(0) 0%,
                Theme.surface 100%,
            );
        }
    }

    // A reset from above (a new headword) moves the page, not just the rail.
    changed scroll-y => { body-flick.content-y = -root.scroll-y; }

    if !root.has-entry: DictEmptyState {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        title: root.empty-title;
        body: root.empty-body;
        closest-label: root.closest-label;
        suggestions: root.suggestions;
    }

    // The copy confirmation: bottom-trailing, over the body only. It never
    // appends a line to the entry and vanishes on its own.
    Rectangle {
        x: root.width - self.width - (Theme.spacing-xxl + Theme.spacing-xs);
        y: root.height - self.height - root.body-bottom;
        width: toast-label.preferred-width + Theme.spacing-xl + 12px + Theme.spacing-sm
            + Theme.spacing-xl;
        height: 30px;
        border-radius: 15px;
        background: Theme.green-soft;
        opacity: root.toast-visible ? 1 : 0;
        animate opacity {
            duration: Theme.duration-hover;
            easing: ease-out;
        }

        GlyphIcon {
            x: Theme.spacing-xl;
            y: (parent.height - self.height) / 2;
            size: 12px;
            name: "checkmark";
            ink: Theme.success;
        }

        toast-label := Text {
            x: Theme.spacing-xl + 12px + Theme.spacing-sm;
            y: 0;
            width: self.preferred-width;
            height: parent.height;
            text: root.copied-label;
            font-family: Theme.font-family;
            font-size: Theme.font-row-trailing;
            color: Theme.success;
            vertical-alignment: center;
        }
    }
}

export component PaletteWindow inherits Window {
    in property <bool> expanded: false;
    // Fluent symbol for the current mode ("magnifyingglass", "chevron.left").
    in property <string> header-symbol;
    // "Opens the AI chat" hint; empty unless expanded and actually available.
    in property <string> tab-hint;
    // DIP reserved to the right of the native field (compact favourites, pills, hint).
    in property <length> search-trailing: 0px;
    // Visible slice of the list, rebuilt by the host as it scrolls.
    in property <[PaletteRow]> rows;
    // AI transcript. The whole transcript is a few dozen fixed-height rows, so
    // it is handed over whole; scroll-y and content-height are the list's.
    in property <bool> chat-mode: false;
    in property <[ChatRow]> chat-rows;
    in property <string> thinking-label;
    in property <bool> hover-armed: false;
    // The row the pointer is over, from the host: a slice rebuild must not
    // leave a stale delegate hover on the wrong row.
    in property <int> hover-index: -1;
    in property <string> empty-text;
    // Glyph above the empty text, the same fluent magnifier in every mode.
    in property <string> empty-symbol;
    // Scroll state. AppCore owns both values; the Flickable follows them.
    in property <length> content-height: 0px;
    in-out property <length> scroll-y: 0px;
    // Clipboard: 290 DIP list + 1 DIP separator + the preview pane.
    in property <bool> split: false;
    in property <length> split-x: 0px;
    in property <string> preview-text;
    // An image capture fills the preview pane; when it decodes, the text
    // fallback (the file path or the storage error) stays hidden.
    in property <image> preview-image;
    in property <bool> preview-image-ready: false;
    // Dictionary page. AppCore owns the entry, the miss suggestions and the
    // copy counter; the panel owns the page's typography and its own scroll.
    // `dictionary-mode` replaces the split preview with the full-width page.
    in property <bool> dictionary-mode: false;
    in property <bool> dictionary-has-entry: false;
    in property <string> dictionary-word;
    in property <string> dictionary-phonetic;
    in property <[DictionaryBadge]> dictionary-badges;
    in property <[DictionaryRow]> dictionary-rows;
    in property <string> dictionary-empty-title;
    in property <string> dictionary-empty-body;
    in property <[string]> dictionary-suggestions;
    in property <string> dictionary-closest-label;
    in property <string> dictionary-source-label;
    in property <string> dictionary-copied-label;
    in property <int> dictionary-copy-token;
    in-out property <length> dictionary-scroll-y: 0px;
    // Clipboard type filter; the host passes rect/title/open from AppCore.
    in property <bool> filter-visible: false;
    in property <string> filter-label;
    in property <bool> filter-open: false;
    in property <length> filter-x: 0px;
    in property <length> filter-y: 0px;
    in property <length> filter-w: 0px;
    in property <length> filter-h: 0px;
    // Fluent arrow.right, between the two calculator columns.
    in property <string> arrow-symbol;
    // Bottom bar: the label is mode dependent, the shortcuts are fixed.
    in property <string> primary-label;
    in property <string> actions-label;
    in property <string> primary-shortcut;
    in property <string> primary-modifier;
    in property <string> actions-shortcut;
    in property <string> actions-modifier;
    in property <bool> show-actions: true;
    in property <bool> primary-destructive: false;
    // In-panel menu overlay. AppCore owns whether a menu is open, its frame
    // (palette_menu::menu_frame), header, items and selection; the surface only
    // plays the reveal and keeps the last frame while it fades out.
    in property <bool> menu-open: false;
    in-out property <bool> menu-visible: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <length> menu-width: 0px;
    in property <length> menu-height: 0px;
    in property <string> menu-header;
    in property <[MenuItem]> menu-items;
    in property <int> menu-selected: -1;
    // Actions/AppMenu hang from the bottom-trailing corner, the header
    // pop-ups from the top-trailing one; the reveal scales from that corner.
    in property <bool> menu-anchored-bottom: true;
    private property <float> menu-scale: Motion.menu-entry-scale;
    private property <float> menu-opacity: 0;

    callback header-clicked();
    callback row-clicked(int, length, length);
    // The clipboard preview: copy the whole item, or hand Esc back to the
    // palette's key path (the native field owns it while the list is up).
    callback copy-preview-all();
    callback preview-escape();
    callback filter-clicked();
    callback scrolled(length);
    callback apps-clicked();
    callback primary-clicked();
    callback actions-clicked();
    callback menu-activated(int);
    callback menu-hovered(int);
    callback menu-dismissed(length, length);
    // The dictionary card's copy button; Esc and Enter stay on the host's key
    // path, so the panel needs no focus scope.
    callback dictionary-copy-requested();

    // Left edge of the native field: 16 DIP gutter + 22 DIP glyph + 8 DIP gap.
    property <length> field-x:
        Theme.spacing-md * 2 + Theme.size-header-icon-slot + Theme.spacing-md;
    // Right edge: the panel's 16 DIP gutter minus whatever the host reserved.
    property <length> field-right:
        Math.max(root.field-x, root.width - Theme.spacing-md * 2 - root.search-trailing);
    // Edge dissolve: the bands overshoot the header and the bottom bar, so only
    // the part inside the list viewport is drawn here.
    property <length> fade-top:
        Math.max(0px, Theme.fade-edge-top-band - Theme.size-compact-height);
    property <length> fade-bottom:
        Math.max(0px, Theme.fade-edge-bottom-band - Theme.size-bottom-bar-height);
    property <float> fade-top-alpha:
        (1 - Theme.fade-edge-top-floor) * (root.fade-top / Theme.fade-edge-top-band);
    property <float> fade-bottom-alpha:
        (1 - Theme.fade-edge-bottom-floor) * (root.fade-bottom / Theme.fade-edge-bottom-band);
    // Viewport between the compact bar and the bottom bar (layout::list::view_height).
    property <length> list-height:
        Theme.size-panel-height - Theme.size-compact-height - Theme.size-bottom-bar-height;
    property <bool> scrollable: root.content-height > root.list-height;

    title: "Tinycast";
    no-frame: true;
    always-on-top: true;
    // The host cuts the real silhouette with a rounded window region and the
    // window is opaque after its DWM blur-behind is cleared. Clear the Slint
    // canvas to the surface colour: a transparent canvas shows the renderer's
    // black clear colour in the half-pixel left over when 750 DIP does not land
    // on a whole physical pixel (125%/150% scaling), which reads as a dark
    // border-right along the panel edge.
    background: Theme.surface;
    default-font-family: "Segoe UI";
    default-font-size: Theme.font-row;
    width: Theme.size-panel-width;
    height: root.expanded ? Theme.size-panel-height : Theme.size-compact-height;

    // The host compares against AppCore's value, so this cannot loop.
    changed scroll-y => { root.scrolled(root.scroll-y); }

    // Opening reveals at 0.94 over duration-menu-open; closing keeps the last
    // frame while it fades to 0 over duration-menu-exit. Control points come
    // from theme::menu_motion (EXPANSION_CURVE / EXIT_CURVE).
    states [
        menu-revealed when root.menu-open: {
            menu-scale: 1;
            menu-opacity: 1;
            in {
                animate menu-scale {
                    duration: Theme.duration-menu-open;
                    easing: cubic-bezier(0.2, 0.7, 0.2, 1);
                }
                animate menu-opacity {
                    duration: Theme.duration-menu-open;
                    easing: cubic-bezier(0.2, 0.7, 0.2, 1);
                }
            }
            out {
                animate menu-scale {
                    duration: Theme.duration-menu-exit;
                    easing: cubic-bezier(0.4, 0, 1, 1);
                }
                animate menu-opacity {
                    duration: Theme.duration-menu-exit;
                    easing: cubic-bezier(0.4, 0, 1, 1);
                }
            }
        }
    ]

    // The first frame of an opening menu must be visible; closing keeps the
    // overlay alive until the exit animation is over.
    changed menu-open => {
        if (root.menu-open) {
            root.menu-visible = true;
        }
    }

    Timer {
        interval: Theme.duration-menu-exit;
        running: root.menu-visible && !root.menu-open;
        triggered => { root.menu-visible = false; }
    }

    Panel {
        expanded: root.expanded;

        // 44 DIP header: the mode glyph, the placeholder and the Tab hint.
        Rectangle {
            height: Theme.size-header-height;
            background: transparent;

            // The search field's chrome (magpie's picker input): the native
            // EDIT fills its own rectangular interior with the same card-2
            // color; this box supplies the rounded edge and line-2 hairline.
            Rectangle {
                x: Theme.spacing-md;
                y: (parent.height - self.height) / 2;
                width: Math.min(
                    root.field-right + Theme.spacing-md,
                    root.width - Theme.spacing-md,
                ) - Theme.spacing-md;
                height: Theme.size-magpie-search;
                border-radius: Theme.radius-row;
                background: Theme.card-2;
                border-width: Theme.size-hairline;
                border-color: Theme.line-2;
            }

            GlyphIcon {
                x: Theme.spacing-md * 2 + (Theme.size-header-icon-slot - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: Theme.size-header-icon-slot - 4px;
                name: root.header-symbol;
            }

            if root.tab-hint != "": Rectangle {
                x: root.field-right;
                y: 0;
                width: Math.max(0px, root.width - Theme.spacing-md * 2 - root.field-right);
                height: parent.height;
                background: transparent;

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-sm;

                    Text {
                        text: root.tab-hint;
                        font-family: "Segoe UI";
                        font-size: Theme.font-row-trailing;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    VerticalLayout {
                        alignment: center;
                        Keycap { text: "⇥"; filled: true; }
                    }
                }
            }

            TouchArea {
                clicked => { root.header-clicked(); }
            }

            // Onto the header, not into its layout: the rect is AppCore's.
            if root.filter-visible: FilterButton {
                x: root.filter-x;
                y: root.filter-y - Theme.size-header-padding;
                width: root.filter-w;
                height: root.filter-h;
                label: root.filter-label;
                open: root.filter-open;
                clicked => { root.filter-clicked(); }
            }
        }

        if root.expanded: Rectangle {
            height: Theme.size-header-padding;
            background: transparent;
        }

        if root.expanded: Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;

            // The list top sits on the 64 DIP compact bar (layout::list::content_top).
            Flickable {
                x: 0;
                y: 0;
                width: root.split ? root.split-x : parent.width;
                height: 100%;
                interactive: false;
                content-y <=> root.scroll-y;
                content-height: root.content-height;

                for row[i] in root.rows: slot := Rectangle {
                    x: 0;
                    y: row.top;
                    width: 100%;
                    height: row.height;
                    background: transparent;

                    if row.kind == 1: SectionHeader {
                        title: row.title;
                    }

                    if row.kind == 0: Row {
                        row-height: row.height;
                        image-row: row.image-row;
                        title: row.title;
                        alias: row.alias;
                        trailing: row.trailing;
                        keycap-text: row.keycap;
                        symbol: row.symbol;
                        checkbox: row.checkbox;
                        icon: row.icon;
                        icon-ready: row.icon-ready;
                        selected: row.selected;
                        hovered: root.hover-armed && i == root.hover-index;
                        clicked(x, y) => { root.row-clicked(i, x, y); }
                    }

                    if row.kind == 2: CalcCard {
                        slot-width: slot.width;
                        expression: row.expression;
                        display: row.title;
                        badge-left: row.badge-left;
                        badge-right: row.badge-right;
                        error-symbol: row.symbol;
                        arrow-symbol: root.arrow-symbol;
                        is-error: row.is-error;
                        selected: row.selected;
                        hovered: root.hover-armed && i == root.hover-index;
                        clicked(x, y) => { root.row-clicked(i, x, y); }
                    }

                    if row.kind == 3: EmojiGridRow {
                        glyphs: row.glyphs;
                        columns: row.columns;
                        start: row.emoji-start;
                        selected: row.emoji-selected;
                        hover-armed: root.hover-armed;
                        clicked(x, y) => { root.row-clicked(i, x, y); }
                    }
                }

                // Zero-height holder: the rows carry the transcript's own y, so
                // they share the list's coordinate space instead of a layout.
                if root.chat-mode: Rectangle {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 0;
                    background: transparent;

                    for row[i] in root.chat-rows: Rectangle {
                        x: 0;
                        y: row.top;
                        width: 100%;
                        height: row.height;
                        background: transparent;

                        ChatLine {
                            role: row.role;
                            text: row.text;
                            failed: row.failed;
                            streaming: row.streaming;
                            thinking-label: root.thinking-label;
                            slot-width: root.width;
                        }
                    }
                }
            }

            // Clipboard: the 1 DIP rule and the wrapped, scrollable preview.
            // The dictionary page owns the whole width instead, so neither the
            // rule nor the preview pane is drawn for it.
            if root.split && !root.dictionary-mode: Rectangle {
                x: root.split-x;
                y: 0;
                width: Theme.size-hairline;
                height: 100%;
                background: Theme.separator;
            }

            if root.split && !root.dictionary-mode && root.preview-image-ready: Rectangle {
                x: root.split-x + Theme.size-hairline;
                y: 0;
                width: parent.width - root.split-x - Theme.size-hairline;
                height: 100%;
                background: transparent;

                Rectangle {
                    x: Theme.spacing-xl;
                    y: Theme.spacing-xl;
                    width: parent.width - Theme.spacing-xl * 2;
                    height: parent.height - Theme.spacing-xl * 2;
                    border-radius: Theme.radius-card;
                    border-width: Theme.size-hairline;
                    border-color: Theme.card-stroke;
                    background: Theme.card-fill;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.preview-image;
                        image-fit: contain;
                    }
                }
            }

            if root.split && !root.dictionary-mode && !root.preview-image-ready: Flickable {
                x: root.split-x + Theme.size-hairline;
                y: 0;
                width: parent.width - root.split-x - Theme.size-hairline;
                height: 100%;
                interactive: true;
                content-width: self.width;
                content-height: Math.max(
                    self.height,
                    preview-body.height + Theme.spacing-xl * 2,
                );

                // Read-only but selectable: drag to mark exactly the span to
                // copy, Ctrl+C copies it (or the whole item when nothing is
                // marked); Esc returns the keyboard to the search field.
                preview-scope := FocusScope {
                    x: Theme.spacing-xl;
                    y: Theme.spacing-xl;
                    width: parent.width - Theme.spacing-xl * 2;
                    height: preview-body.height;

                    preview-body := TextInput {
                        width: 100%;
                        height: self.preferred-height;
                        text: root.preview-text;
                        wrap: word-wrap;
                        read-only: true;
                        single-line: false;
                        font-family: "Segoe UI";
                        font-size: Theme.font-row;
                        color: Theme.text-primary;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: Theme.text-primary;
                    }

                    key-pressed(event) => {
                        if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                            if (preview-body.cursor-position-byte-offset
                                != preview-body.anchor-position-byte-offset) {
                                preview-body.copy();
                            } else {
                                root.copy-preview-all();
                            }
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.preview-escape();
                            return accept;
                        }
                        reject
                    }
                }
            }

            // Edge dissolve: the surface fades the first and last visible rows.
            // The dictionary page keeps its own header card and scroll state,
            // so the list's bands never draw over it.
            if root.scrollable && !root.dictionary-mode: Rectangle {
                y: 0;
                width: root.split ? root.split-x : parent.width;
                height: Math.min(root.fade-top, parent.height);
                background: @linear-gradient(
                    180deg,
                    Theme.surface.with-alpha(root.fade-top-alpha) 0%,
                    Theme.surface.with-alpha(0) 100%,
                );
            }

            if root.scrollable && !root.dictionary-mode: Rectangle {
                y: parent.height - Math.min(root.fade-bottom, parent.height);
                width: root.split ? root.split-x : parent.width;
                height: Math.min(root.fade-bottom, parent.height);
                background: @linear-gradient(
                    180deg,
                    Theme.surface.with-alpha(0) 0%,
                    Theme.surface.with-alpha(root.fade-bottom-alpha) 100%,
                );
            }

            if root.empty-text != "" && root.rows.length == 0: Rectangle {
                y: 0;
                height: 100%;
                width: 100%;
                background: transparent;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: Theme.spacing-md;

                    HorizontalLayout {
                        alignment: center;

                        GlyphIcon {
                            size: Theme.size-empty-results-glyph;
                            name: root.empty-symbol;
                            ink: Theme.text-tertiary;
                        }
                    }

                    Text {
                        text: root.empty-text;
                        font-family: "Segoe UI";
                        font-size: Theme.font-row;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // Shared 16 DIP target with direct thumb dragging and track seek.
            // The dictionary page brings its own rail, so the list's one never
            // draws for it.
            if !root.dictionary-mode: Scrollbar {
                // In split mode the rail hugs the 290 DIP list column.
                x: root.split
                    ? root.split-x - Theme.size-scrollbar-inset - self.width
                    : parent.width - Theme.size-scrollbar-inset - self.width;
                y: Theme.size-scrollbar-inset;
                height: parent.height - Theme.size-scrollbar-inset * 2;
                content-height: root.content-height;
                viewport-height: parent.height;
                // content-y is negative while scrolled down; the rail wants a
                // positive offset.
                offset: -root.scroll-y;
                scroll-to(offset) => { root.scroll-y = -offset; }
            }

            // The dictionary page covers the whole content area: its card is
            // fixed and its own rail scrolls the body, so the list's scrollbar
            // and fades above it stay unused (no rows, content height 0).
            if root.dictionary-mode: DictionaryPanel {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                has-entry: root.dictionary-has-entry;
                word: root.dictionary-word;
                phonetic: root.dictionary-phonetic;
                badges: root.dictionary-badges;
                rows: root.dictionary-rows;
                empty-title: root.dictionary-empty-title;
                empty-body: root.dictionary-empty-body;
                suggestions: root.dictionary-suggestions;
                closest-label: root.dictionary-closest-label;
                source-label: root.dictionary-source-label;
                copied-label: root.dictionary-copied-label;
                copy-token: root.dictionary-copy-token;
                scroll-y: root.dictionary-scroll-y;
                copy-requested => { root.dictionary-copy-requested(); }
            }
        }

        if root.expanded: Footer {
            primary-label: root.primary-label;
            actions-label: root.actions-label;
            primary-shortcut: root.primary-shortcut;
            primary-modifier: root.primary-modifier;
            actions-shortcut: root.actions-shortcut;
            actions-modifier: root.actions-modifier;
            show-actions: root.show-actions;
            primary-destructive: root.primary-destructive;
            apps-clicked => { root.apps-clicked(); }
            primary-clicked => { root.primary-clicked(); }
            actions-clicked => { root.actions-clicked(); }
        }
    }

    // A palette menu is an in-panel overlay, never a native PopupWindow: the
    // native search field keeps focus, and AppCore's menu_frame already fits
    // the 475 DIP panel. The backdrop swallows the click that closes it so it
    // can never reach the row or footer underneath.
    if root.menu-visible: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;

        dismiss-touch := TouchArea {
            clicked => {
                root.menu-dismissed(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    if root.menu-visible: Menu {
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-width;
        height: root.menu-height;
        header: root.menu-header;
        items: root.menu-items;
        selected: root.menu-selected;
        opacity: root.menu-opacity;
        transform-scale: root.menu-scale;
        transform-origin: {
            x: root.menu-width,
            y: root.menu-anchored-bottom ? root.menu-height : 0px,
        };
        activated(i) => { root.menu-activated(i); }
        hovered(i) => { root.menu-hovered(i); }
    }
}
