// The command palette. The squircle, the header, the rows and the chrome are
// Slint; the search field itself is a native EDIT child the host parents to
// this window, so the placeholder is drawn here and shows through it.
import { Theme } from "../theme.slint";
import { Panel } from "../primitives/panel.slint";
import { Keycap } from "../primitives/keycap.slint";
import { Row, SectionHeader } from "../primitives/row.slint";
import { Scrollbar } from "../primitives/scrollbar.slint";
import { Footer } from "../primitives/footer.slint";

// Row kinds shared with crates/tinycast/src/ui_host/snapshot.rs.
// 0 result row, 1 section header, 2 calculator card, 3 emoji row.
export struct PaletteRow {
    kind: int,
    title: string,
    trailing: string,
    keycap: string,
    symbol: string,
    alias: string,
    expression: string,
    badge-left: string,
    badge-right: string,
    is-error: bool,
    glyphs: [string],
    columns: int,
    emoji-start: int,
    emoji-selected: int,
    checkbox: int,
    icon: image,
    icon-ready: bool,
    selected: bool,
    top: length,
    height: length,
}

// A badge under one calculator column: 11 DIP ink on controlSurface.
component CalcBadge inherits Rectangle {
    in property <string> text;

    height: Theme.font-calc-badge + Theme.spacing-xs;
    border-radius: Theme.radius-key-cap;
    background: Theme.control-surface;

    HorizontalLayout {
        padding-left: Theme.spacing-sm;
        padding-right: Theme.spacing-sm;

        Text {
            text: root.text;
            font-family: "Segoe UI";
            font-size: Theme.font-calc-badge;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One 96 DIP answer card: expression to result, or a triangle and the message.
// Two columns share the card; the 22 DIP arrows is the only fixed slot between.
component CalcCard inherits Rectangle {
    in property <string> expression;
    in property <string> display;
    in property <string> badge-left;
    in property <string> badge-right;
    in property <string> error-symbol;
    in property <string> arrow-symbol;
    in property <bool> is-error: false;
    in property <bool> selected: false;
    in property <bool> hover-armed: false;
    // The list column width; a component cannot read its parent.
    in property <length> slot-width;

    callback clicked(length, length);

    x: Theme.spacing-xl;
    y: 0;
    width: root.slot-width - Theme.spacing-xl * 2;
    height: Theme.size-calc-card-height;
    border-radius: Theme.radius-card;
    background: root.selected ? Theme.selection
        : (root.hover-armed && card-touch.has-hover ? Theme.row-hover : Theme.card-fill);

    if root.is-error: HorizontalLayout {
        padding-left: Theme.spacing-xxxl;
        padding-right: Theme.spacing-xxxl;
        spacing: Theme.spacing-md;

        Text {
            text: root.error-symbol;
            font-family: "Segoe Fluent Icons";
            font-size: Theme.font-header-icon;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        Text {
            text: root.display;
            font-family: "Segoe UI";
            font-size: Theme.font-row;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    if !root.is-error: HorizontalLayout {
        padding-top: Theme.spacing-xxxl;
        padding-bottom: Theme.spacing-xxxl;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        spacing: Theme.spacing-sm;

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            VerticalLayout {
                alignment: space-between;

                Text {
                    text: root.expression;
                    font-family: "Segoe UI";
                    font-size: Theme.font-row-trailing;
                    font-weight: 500;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.badge-left != "": CalcBadge {
                    text: root.badge-left;
                    horizontal-stretch: 0;
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Text {
                text: root.arrow-symbol;
                font-family: "Segoe Fluent Icons";
                font-size: Theme.font-header-icon;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            VerticalLayout {
                alignment: space-between;

                Text {
                    text: root.display;
                    font-family: "Segoe UI";
                    font-size: Theme.font-calc-result;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.badge-right != "": CalcBadge {
                    text: root.badge-right;
                    horizontal-stretch: 0;
                }
            }
        }
    }

    card-touch := TouchArea {
        clicked => {
            root.clicked(
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y,
            );
        }
    }
}

// One 56 DIP emoji grid row. Cells split the list width into the model's
// column count; the selected cell gets a 2 DIP border and the glyph keeps
// every colour (Segoe UI Emoji is COLR, so no tint is applied).
component EmojiGridRow inherits Rectangle {
    in property <[string]> glyphs;
    in property <int> columns: 8;
    in property <int> start;
    in property <int> selected;
    in property <bool> hover-armed: false;

    callback clicked(length, length);

    height: Theme.size-emoji-cell;
    background: transparent;
    property <length> cell-width: self.width / Math.max(1, root.columns);

    for glyph[k] in root.glyphs: Rectangle {
        x: k * root.cell-width;
        y: 0;
        width: root.cell-width;
        height: root.height;
        background: transparent;

        Rectangle {
            x: Theme.size-hairline * 2;
            y: Theme.size-hairline * 2;
            width: parent.width - Theme.size-hairline * 4;
            height: parent.height - Theme.size-hairline * 4;
            border-radius: Theme.radius-emoji-cell;
            background: root.start + k == root.selected ? Theme.selection : Theme.emoji-cell;
            border-width: (root.start + k == root.selected)
                || (root.hover-armed && cell-touch.has-hover)
                ? Theme.size-hairline * 2 : 0px;
            border-color: root.start + k == root.selected
                ? Theme.emoji-selection-border : Theme.emoji-hover-border;
        }

        Text {
            text: glyph;
            font-family: "Segoe UI Emoji";
            font-size: Theme.font-emoji;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        cell-touch := TouchArea {
            clicked => {
                root.clicked(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }
}

// The clipboard type filter in the header's trailing slot.
component FilterButton inherits Rectangle {
    in property <string> label;
    in property <bool> open: false;

    callback clicked;

    border-radius: Theme.radius-bar-control;
    background: root.open ? Theme.selection
        : (filter-touch.has-hover ? Theme.control-hover : Theme.control-surface);

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;

        Text {
            text: root.label;
            font-family: "Segoe UI";
            font-size: Theme.font-row-trailing;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    filter-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PaletteWindow inherits Window {
    // Squircle path commands for the current size, from tinycast_ui::squircle_commands.
    in property <string> squircle-commands;
    in property <bool> expanded: false;
    // Fluent symbol for the current mode ("magnifyingglass", "chevron.left").
    in property <string> header-symbol;
    // Placeholder from PaletteMode::placeholder; only drawn for an empty query.
    in property <string> placeholder;
    in property <bool> show-placeholder: false;
    // "Opens the AI chat" hint; empty unless expanded and actually available.
    in property <string> tab-hint;
    // DIP reserved to the right of the native field (compact favourites, pills, hint).
    in property <length> search-trailing: 0px;
    // Visible slice of the list, rebuilt by the host as it scrolls.
    in property <[PaletteRow]> rows;
    in property <bool> hover-armed: false;
    in property <string> empty-text;
    // Glyph above the empty text, the same fluent magnifier in every mode.
    in property <string> empty-symbol;
    // Scroll state. AppCore owns both values; the Flickable follows them.
    in property <length> content-height: 0px;
    in-out property <length> scroll-y: 0px;
    // Clipboard: 290 DIP list + 1 DIP separator + the preview pane.
    in property <bool> split: false;
    in property <length> split-x: 0px;
    in property <string> preview-text;
    // Clipboard type filter; the host passes rect/title/open from AppCore.
    in property <bool> filter-visible: false;
    in property <string> filter-label;
    in property <bool> filter-open: false;
    in property <length> filter-x: 0px;
    in property <length> filter-y: 0px;
    in property <length> filter-w: 0px;
    in property <length> filter-h: 0px;
    // Fluent arrow.right, between the two calculator columns.
    in property <string> arrow-symbol;
    // Bottom bar: the label is mode dependent, the shortcuts are fixed.
    in property <string> primary-label;
    in property <string> actions-label;
    in property <string> primary-shortcut;
    in property <string> primary-modifier;
    in property <string> actions-shortcut;
    in property <string> actions-modifier;
    in property <bool> show-actions: true;
    in property <bool> primary-destructive: false;

    callback header-clicked();
    callback row-clicked(int, length, length);
    callback filter-clicked();
    callback scrolled(length);
    callback apps-clicked();
    callback primary-clicked();
    callback actions-clicked();

    // Left edge of the native field: 16 DIP gutter + 22 DIP glyph + 8 DIP gap.
    property <length> field-x:
        Theme.spacing-md * 2 + Theme.size-header-icon-slot + Theme.spacing-md;
    // Right edge: the panel's 16 DIP gutter minus whatever the host reserved.
    property <length> field-right:
        Math.max(root.field-x, root.width - Theme.spacing-md * 2 - root.search-trailing);
    // Edge dissolve: the bands overshoot the header and the bottom bar, so only
    // the part inside the list viewport is drawn here.
    property <length> fade-top:
        Math.max(0px, Theme.fade-edge-top-band - Theme.size-compact-height);
    property <length> fade-bottom:
        Math.max(0px, Theme.fade-edge-bottom-band - Theme.size-bottom-bar-height);
    property <float> fade-top-alpha:
        (1 - Theme.fade-edge-top-floor) * (root.fade-top / Theme.fade-edge-top-band);
    property <float> fade-bottom-alpha:
        (1 - Theme.fade-edge-bottom-floor) * (root.fade-bottom / Theme.fade-edge-bottom-band);
    // Viewport between the compact bar and the bottom bar (layout::list::view_height).
    property <length> list-height:
        Theme.size-panel-height - Theme.size-compact-height - Theme.size-bottom-bar-height;
    property <bool> scrollable: root.content-height > root.list-height;

    title: "Tinycast";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: Theme.font-row;
    width: Theme.size-panel-width;
    height: root.expanded ? Theme.size-panel-height : Theme.size-compact-height;

    // The host compares against AppCore's value, so this cannot loop.
    changed scroll-y => { root.scrolled(root.scroll-y); }

    Panel {
        squircle-commands: root.squircle-commands;
        expanded: root.expanded;

        // 44 DIP header: the mode glyph, the placeholder and the Tab hint.
        Rectangle {
            height: Theme.size-header-height;
            background: transparent;

            Text {
                x: Theme.spacing-md * 2;
                width: Theme.size-header-icon-slot;
                height: parent.height;
                text: root.header-symbol;
                font-family: "Segoe Fluent Icons";
                font-size: Theme.font-header-icon;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.show-placeholder: Text {
                x: root.field-x;
                y: 0;
                width: root.field-right - root.field-x;
                height: parent.height;
                text: root.placeholder;
                font-family: "Segoe UI";
                font-size: Theme.font-search;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.tab-hint != "": Rectangle {
                x: root.field-right;
                y: 0;
                width: Math.max(0px, root.width - Theme.spacing-md * 2 - root.field-right);
                height: parent.height;
                background: transparent;

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-sm;

                    Text {
                        text: root.tab-hint;
                        font-family: "Segoe UI";
                        font-size: Theme.font-row-trailing;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    VerticalLayout {
                        alignment: center;
                        Keycap { text: "⇥"; filled: true; }
                    }
                }
            }

            TouchArea {
                clicked => { root.header-clicked(); }
            }

            // Onto the header, not into its layout: the rect is AppCore's.
            if root.filter-visible: FilterButton {
                x: root.filter-x;
                y: root.filter-y - Theme.size-header-padding;
                width: root.filter-w;
                height: root.filter-h;
                label: root.filter-label;
                open: root.filter-open;
                clicked => { root.filter-clicked(); }
            }
        }

        if root.expanded: Rectangle {
            height: Theme.size-header-padding;
            background: transparent;
        }

        if root.expanded: Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;

            // The list top sits on the 64 DIP compact bar (layout::list::content_top).
            Flickable {
                x: 0;
                y: 0;
                width: root.split ? root.split-x : parent.width;
                height: 100%;
                interactive: false;
                content-y <=> root.scroll-y;
                content-height: root.content-height;

                for row[i] in root.rows: slot := Rectangle {
                    x: 0;
                    y: row.top;
                    width: 100%;
                    height: row.height;
                    background: transparent;

                    if row.kind == 1: SectionHeader {
                        title: row.title;
                    }

                    if row.kind == 0: Row {
                        title: row.title;
                        alias: row.alias;
                        trailing: row.trailing;
                        keycap-text: row.keycap;
                        symbol: row.symbol;
                        checkbox: row.checkbox;
                        icon: row.icon;
                        icon-ready: row.icon-ready;
                        selected: row.selected;
                        hover-armed: root.hover-armed;
                        clicked(x, y) => { root.row-clicked(i, x, y); }
                    }

                    if row.kind == 2: CalcCard {
                        slot-width: slot.width;
                        expression: row.expression;
                        display: row.title;
                        badge-left: row.badge-left;
                        badge-right: row.badge-right;
                        error-symbol: row.symbol;
                        arrow-symbol: root.arrow-symbol;
                        is-error: row.is-error;
                        selected: row.selected;
                        hover-armed: root.hover-armed;
                        clicked(x, y) => { root.row-clicked(i, x, y); }
                    }

                    if row.kind == 3: EmojiGridRow {
                        glyphs: row.glyphs;
                        columns: row.columns;
                        start: row.emoji-start;
                        selected: row.emoji-selected;
                        hover-armed: root.hover-armed;
                        clicked(x, y) => { root.row-clicked(i, x, y); }
                    }
                }
            }

            // Clipboard: the 1 DIP rule and the wrapped, scrollable preview.
            if root.split: Rectangle {
                x: root.split-x;
                y: 0;
                width: Theme.size-hairline;
                height: 100%;
                background: Theme.separator;
            }

            if root.split: Flickable {
                x: root.split-x + Theme.size-hairline;
                y: 0;
                width: parent.width - root.split-x - Theme.size-hairline;
                height: 100%;
                interactive: true;
                content-width: self.width;
                content-height: Math.max(
                    self.height,
                    preview-body.height + Theme.spacing-xl * 2,
                );

                preview-body := Text {
                    x: Theme.spacing-xl;
                    y: Theme.spacing-xl;
                    width: parent.width - Theme.spacing-xl * 2;
                    text: root.preview-text;
                    wrap: word-wrap;
                    font-family: "Segoe UI";
                    font-size: Theme.font-row;
                    color: Theme.text-primary;
                }
            }

            // Edge dissolve: the scrim fades the first and last visible rows.
            if root.scrollable: Rectangle {
                y: 0;
                width: root.split ? root.split-x : parent.width;
                height: Math.min(root.fade-top, parent.height);
                background: @linear-gradient(
                    180deg,
                    Theme.scrim.with-alpha(root.fade-top-alpha) 0%,
                    Theme.scrim.with-alpha(0) 100%,
                );
            }

            if root.scrollable: Rectangle {
                y: parent.height - Math.min(root.fade-bottom, parent.height);
                width: root.split ? root.split-x : parent.width;
                height: Math.min(root.fade-bottom, parent.height);
                background: @linear-gradient(
                    180deg,
                    Theme.scrim.with-alpha(0) 0%,
                    Theme.scrim.with-alpha(root.fade-bottom-alpha) 100%,
                );
            }

            if root.empty-text != "" && root.rows.length == 0: Rectangle {
                y: 0;
                height: 100%;
                width: 100%;
                background: transparent;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.spacing-md;

                    Text {
                        text: root.empty-symbol;
                        font-family: "Segoe Fluent Icons";
                        font-size: Theme.size-empty-results-glyph;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.empty-text;
                        font-family: "Segoe UI";
                        font-size: Theme.font-row;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // 16 DIP hover strip: the 6/10 DIP rail alone is a 6 px target.
            Scrollbar {
                // self.width is 6 at rest and 10 under the pointer; in split mode
                // the rail hugs the 290 DIP list column instead of the panel edge.
                x: root.split
                    ? root.split-x - Theme.size-scrollbar-inset - self.width
                    : parent.width - Theme.size-scrollbar-inset - self.width;
                y: Theme.size-scrollbar-inset;
                height: parent.height - Theme.size-scrollbar-inset * 2;
                content-height: root.content-height;
                viewport-height: parent.height;
                // content-y is negative while scrolled down; the rail wants a
                // positive offset.
                offset: -root.scroll-y;
                hovered: scroll-zone.has-hover;
            }

            scroll-zone := TouchArea {
                x: root.split
                    ? root.split-x - Theme.size-scrollbar-hover-zone
                    : parent.width - Theme.size-scrollbar-hover-zone;
                y: 0;
                width: Theme.size-scrollbar-hover-zone;
                height: 100%;
            }
        }

        if root.expanded: Footer {
            primary-label: root.primary-label;
            actions-label: root.actions-label;
            primary-shortcut: root.primary-shortcut;
            primary-modifier: root.primary-modifier;
            actions-shortcut: root.actions-shortcut;
            actions-modifier: root.actions-modifier;
            show-actions: root.show-actions;
            primary-destructive: root.primary-destructive;
            apps-clicked => { root.apps-clicked(); }
            primary-clicked => { root.primary-clicked(); }
            actions-clicked => { root.actions-clicked(); }
        }
    }
}