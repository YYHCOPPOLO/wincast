// Design tokens. The only source is crates/tinycast-pure/src/theme.rs and
// motion.rs; src/bridge.rs fills every property at startup. Do not author a
// second colour or metric table here.

export global Theme {
    in property <bool> dark;

    // Colors. Page/surface/muted/border and the text ramp are the opaque Magpie
    // values from `theme::colors`; selection and hover stay translucent ink.
    in property <color> page;
    in property <color> surface;
    in property <color> surface-muted;
    // The 1 px border of a panel, menu, dialog or card (`surface_border_rgba`).
    in property <color> border;
    in property <color> selection;
    in property <color> row-hover;
    in property <color> text-primary;
    in property <color> text-secondary;
    in property <color> text-tertiary;
    // Destructive/success ink: Magpie's `--red`/`--green` from app.css.
    in property <color> destructive;
    in property <color> success;
    // Accent trio (`--accent*`), the picker's solid selected fill (`--sel`),
    // the second card step (`--card-2`), the remaining ink steps (`--fg-2`,
    // `--faint`, `--ctl-fg`), hovered pill fill (`--pill-hover`), status amber
    // and the soft badge tiles (`--*-soft`), and the segmented-control pair.
    in property <color> accent;
    in property <color> accent-soft;
    in property <color> accent-fg;
    in property <color> sel;
    // The weaker input hairline (`--line-2`), versus `border` (`--line`).
    in property <color> line-2;
    in property <color> card-2;
    in property <color> fg-2;
    in property <color> faint;
    in property <color> ctl-fg;
    in property <color> pill-hover;
    in property <color> amber;
    in property <color> green-soft;
    in property <color> red-soft;
    in property <color> amber-soft;
    in property <color> seg-track;
    in property <color> seg-thumb;
    // The switch thumb while off (literal white in both appearances).
    in property <color> toggle-thumb;
    in property <color> control-surface;
    // Card/menu surfaces repeat the plain surface/border pair, never a tint.
    in property <color> card-fill;
    in property <color> card-stroke;
    in property <color> separator;
    in property <color> menu-hover;
    in property <color> menu-fill;
    in property <color> menu-border;
    in property <color> control-hover;
    in property <color> control-pressed;
    in property <color> menu-symbol;
    in property <color> note-text;
    in property <color> icon-placeholder;
    in property <color> emoji-cell;
    in property <color> emoji-hover-border;
    in property <color> emoji-selection-border;
    in property <color> composer-send;
    in property <color> drop-guide;
    in property <color> settings-sidebar;
    in property <color> settings-detail;

    // Typography (`theme::typography`), in DIP.
    in property <string> font-family;
    in property <length> font-search;
    in property <length> font-header-icon;
    in property <length> font-row;
    in property <length> font-row-trailing;
    in property <length> font-bar;
    in property <length> font-section;
    in property <length> font-keycap;
    in property <length> font-panel-title;
    in property <length> font-calc-result;
    in property <length> font-calc-badge;
    in property <length> font-chip;
    in property <length> font-emoji;

    // Spacing (`theme::spacing`).
    in property <length> spacing-xxs;
    in property <length> spacing-xs;
    in property <length> spacing-sm;
    in property <length> spacing-md;
    in property <length> spacing-lg;
    in property <length> spacing-xl;
    in property <length> spacing-xxl;
    in property <length> spacing-xxxl;
    in property <length> spacing-dialog-inset;
    in property <length> spacing-dialog-content-inset;
    in property <length> spacing-section-header-bottom;
    in property <length> spacing-section;
    in property <length> spacing-emoji-section;
    in property <length> spacing-chat-line;

    // Corner radii (`theme::radius`).
    in property <length> radius-panel;
    in property <length> radius-row;
    in property <length> radius-menu;
    in property <length> radius-menu-row;
    in property <length> radius-menu-panel;
    in property <length> radius-dialog;
    in property <length> radius-dialog-surface;
    in property <length> radius-dialog-symbol;
    in property <length> radius-emoji-cell;
    in property <length> radius-bar-control;
    in property <length> radius-thumbnail;
    in property <length> radius-glyph;
    in property <length> radius-attachment-chip;
    in property <length> radius-card;
    // Magpie settings vocabulary: the list card (.list, 12) and the control
    // corners (.field/.editor input, 8).
    in property <length> radius-magpie-card;
    in property <length> radius-magpie-control;
    in property <length> radius-key-cap;
    in property <length> radius-recorder-key-cap;
    in property <length> radius-tooltip;

    // Sizes (`theme::size`).
    in property <length> size-panel-width;
    in property <length> size-panel-height;
    in property <length> size-header-height;
    in property <length> size-header-icon-slot;
    in property <length> size-header-padding;
    in property <length> size-compact-height;
    in property <length> size-palette-snap-distance;
    in property <length> size-palette-minimum-visible;
    in property <float> size-palette-top-margin-fraction;
    in property <length> size-drop-guide-dash;
    in property <length> size-drop-guide-gap;
    in property <length> size-drop-guide-width;
    in property <length> size-bottom-bar-height;
    in property <length> size-bar-button-height;
    in property <length> size-bar-menu-line-long;
    in property <length> size-bar-menu-line-short;
    in property <length> size-bar-menu-line;
    in property <length> size-bar-circle;
    in property <length> size-row-height;
    in property <length> size-section-header-height;
    in property <length> size-row-icon;
    in property <length> size-result-row-icon;
    in property <length> size-row-padding-x;
    in property <length> size-row-padding-y;
    in property <length> size-row-content-left;
    in property <length> size-row-icon-gap;
    in property <length> size-scrollbar-width;
    in property <length> size-scrollbar-hover-width;
    in property <length> size-scrollbar-min-thumb;
    in property <length> size-scrollbar-inset;
    in property <length> size-scrollbar-hover-zone;
    in property <length> size-empty-results-glyph;
    in property <length> size-key-cap;
    in property <length> size-compact-key-cap;
    in property <length> size-hero-key-cap;
    in property <length> size-shortcut-recorder;
    in property <length> size-shortcut-popover-line;
    in property <length> size-callout-caret-width;
    in property <length> size-callout-caret-height;
    in property <length> size-callout-caret-tip;
    in property <length> size-shortcut-popover-width;
    in property <length> size-shortcut-popover-height;
    in property <length> size-menu-button;
    in property <length> size-menu-width;
    in property <length> size-action-menu-width;
    in property <length> size-clipboard-filter-menu-width;
    in property <length> size-file-search-filter-menu-width;
    in property <length> size-emoji-category-menu-width;
    in property <length> size-menu-row-height;
    in property <length> size-menu-row-spacing;
    in property <length> size-menu-section-header;
    in property <float> size-menu-visible-rows;
    in property <length> size-menu-icon;
    in property <length> size-menu-brand-icon;
    in property <length> size-bar-brand-icon;
    in property <length> size-calc-card-height;
    in property <length> size-chat-image-thumb;
    in property <length> size-chat-attachment-glyph;
    in property <length> size-settings-window-width;
    in property <length> size-settings-window-height;
    in property <length> size-settings-sidebar;
    in property <length> size-settings-detail-minimum;
    in property <length> size-settings-row-icon;
    in property <length> size-settings-row-height;
    // Magpie control heights: value select button (.field, 25), single-line
    // form input (.editor input, 27) and the dense list row (36).
    in property <length> size-magpie-field;
    in property <length> size-magpie-input;
    in property <length> size-magpie-search;
    in property <length> size-magpie-list-item;
    in property <length> size-editor-sheet-width;
    in property <length> size-form-label-width;
    in property <length> size-editor-text-height;
    in property <length> size-argument-prompt-width;
    in property <length> size-hud-max-width;
    in property <length> size-hud-edge-offset;
    in property <length> size-hud-width;
    in property <length> size-hud-height;
    in property <length> size-dialog-compact-width;
    in property <length> size-dialog-width;
    in property <length> size-dialog-button-height;
    in property <length> size-dialog-symbol;
    in property <length> size-dialog-symbol-container;
    in property <length> size-dialog-icon;
    in property <length> size-camera-preview-width;
    in property <length> size-camera-preview-height;
    // The Support/About window: client size and the heart tile.
    in property <length> size-support-window-width;
    in property <length> size-support-window-height;
    in property <length> size-support-icon;
    in property <length> size-quick-action-panel;
    in property <length> size-quick-action-header-icon;
    in property <length> size-quick-action-scroll-fade;
    in property <length> size-quick-action-panel-body;
    in property <length> size-quick-action-panel-min-body;
    in property <length> size-volume-track;
    in property <length> size-volume-knob;
    in property <length> size-volume-readout;
    in property <length> size-note-window-width;
    in property <length> size-note-window-height;
    in property <length> size-note-editor-inset;
    in property <length> size-note-editor-top-inset;
    in property <length> size-note-search-height;
    in property <length> size-note-switcher-width;
    in property <length> size-note-switcher-height;
    in property <length> size-note-switcher-empty-height;
    in property <length> size-note-switcher-drop;
    in property <length> size-note-footer;
    in property <length> size-note-titlebar;
    in property <length> size-note-title-inset;
    in property <length> size-note-traffic-light-inset;
    in property <length> size-note-glyph;
    in property <length> size-note-empty-glyph;
    in property <length> size-emoji-cell;
    in property <length> size-emoji-grid-inset;
    in property <length> size-clipboard-list-width;
    in property <length> size-checkbox;
    in property <length> size-toggle-width;
    in property <length> size-toggle-height;
    in property <length> size-sidebar-row;
    in property <length> size-hairline;
    in property <length> size-chat-message-action;
    in property <length> size-markdown-list-marker;
    in property <length> size-markdown-quote-bar;

    // Edge dissolve bands (`theme::fade`).
    in property <length> fade-edge-top-overshoot;
    in property <length> fade-edge-bottom-overshoot;
    in property <float> fade-edge-top-floor;
    in property <float> fade-edge-bottom-floor;
    in property <length> fade-edge-top-band;
    in property <length> fade-edge-bottom-band;
    in property <length> fade-overflow-band;
    in property <length> fade-popup-band;

    // Thin scrollbar alphas (`theme::scrollbar`).
    in property <float> scrollbar-rest-alpha;
    in property <float> scrollbar-hover-alpha;
    in property <float> scrollbar-drag-alpha;

    // Durations (`theme::duration`, `theme::menu_motion`).
    in property <duration> duration-enter;
    in property <duration> duration-exit;
    in property <duration> duration-dialog-enter;
    in property <duration> duration-dialog-exit;
    in property <duration> duration-tooltip;
    in property <duration> duration-tooltip-delay;
    in property <duration> duration-hover;
    in property <duration> duration-menu-chevron;
    in property <duration> duration-drop-guide;
    in property <duration> duration-copy-feedback;
    in property <duration> duration-chat-footer;
    in property <duration> duration-scrollbar-fade;
    in property <duration> duration-scrollbar-idle;
    in property <duration> duration-scrollbar-hover-exit;
    in property <duration> duration-scrollbar-spring;
    in property <duration> duration-toggle-spring;
    in property <duration> duration-onboarding;
    in property <duration> duration-shortcut-hover;
    in property <duration> duration-shortcut-popover;
    in property <duration> duration-toast;
    in property <duration> duration-message-hud;
    in property <duration> duration-volume-hud;
    in property <duration> duration-menu-open;
    in property <duration> duration-menu-exit;

}

// Motion curves and spring constants (`tinycast_pure::motion`).
// Durations mirror Theme.duration-* so an animation reads one global.
export global Motion {
    in property <float> enter-scale;
    in property <float> callout-scale;
    in property <duration> enter;
    in property <duration> exit;
    in property <duration> dialog-enter;
    in property <duration> dialog-exit;
    in property <length> dialog-offset;
    in property <float> dialog-initial-opacity;
    in property <float> menu-entry-scale;
    in property <float> menu-max-scale;
    in property <float> menu-exit-scale-delta;
    in property <duration> menu-expansion;
    in property <duration> menu-settle;
    in property <duration> menu-exit;
    in property <float> menu-expansion-x1;
    in property <float> menu-expansion-y1;
    in property <float> menu-expansion-x2;
    in property <float> menu-expansion-y2;
    in property <float> menu-settle-x1;
    in property <float> menu-settle-y1;
    in property <float> menu-settle-x2;
    in property <float> menu-settle-y2;
    in property <float> menu-exit-x1;
    in property <float> menu-exit-y1;
    in property <float> menu-exit-x2;
    in property <float> menu-exit-y2;
    in property <float> menu-chevron-x1;
    in property <float> menu-chevron-y1;
    in property <float> menu-chevron-x2;
    in property <float> menu-chevron-y2;
    in property <float> scrollbar-spring-bounce;
    in property <duration> scrollbar-spring;
    in property <float> toggle-spring-bounce;
    in property <duration> toggle-spring;
    in property <duration> hud-message;
    in property <duration> hud-volume;
}
