import { Theme } from "../theme.slint";

// Thin overlay rail: 6 DIP at rest, 10 DIP under the pointer, 28 DIP minimum
// thumb.
export component Scrollbar inherits Rectangle {
    in property <length> content-height;
    in property <length> viewport-height;
    in property <length> offset;
    in property <bool> dragging: false;
    // The palette arms this from its 16 DIP hover strip; the rail alone is too
    // narrow to hit.
    in property <bool> hovered: false;

    width: (root.hovered || touch.has-hover)
        ? Theme.size-scrollbar-hover-width : Theme.size-scrollbar-width;
    height: 100%;
    background: transparent;
    visible: root.content-height > root.viewport-height;

    animate width {
        duration: 120ms;
        easing: ease-out;
    }

    // `visible: false` still evaluates the bindings, so every divisor is guarded.
    property <length> safe-content: Math.max(1px, root.content-height);
    property <length> travel: Math.max(0px, root.height - thumb.height);
    property <length> thumb-height: Math.max(
        Theme.size-scrollbar-min-thumb,
        root.height * (root.viewport-height / root.safe-content),
    );
    property <length> thumb-y:
        root.offset
            / Math.max(1px, root.safe-content - root.viewport-height)
            * root.travel;
    property <bool> lit: root.hovered || touch.has-hover;

    thumb := Rectangle {
        y: root.thumb-y;
        width: parent.width;
        height: root.thumb-height;
        border-radius: self.width / 2;
        background: Theme.text-primary.with-alpha(
            root.dragging ? Theme.scrollbar-drag-alpha
            : root.lit ? Theme.scrollbar-hover-alpha
            : Theme.scrollbar-rest-alpha,
        );

        // The thumb tracks the wheel directly: a short ease-out smooths wheel
        // steps without the spring's bounce, which read as lag then a jump.
        animate y, height {
            duration: 96ms;
            easing: ease-out;
        }
    }

    touch := TouchArea {}
}
