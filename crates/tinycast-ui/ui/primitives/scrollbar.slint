import { Theme, Motion } from "../theme.slint";

// Thin overlay rail: 6 DIP at rest, 10 DIP under the pointer, 28 DIP minimum
// thumb. The spring is the thin-scrollbar morph (response 0.28, damping 0.85).
export component Scrollbar inherits Rectangle {
    in property <length> content-height;
    in property <length> viewport-height;
    in property <length> offset;
    in property <bool> dragging: false;
    // The palette arms this from its 16 DIP hover strip; the rail alone is too
    // narrow to hit.
    in property <bool> hovered: false;

    width: (root.hovered || touch.has-hover)
        ? Theme.size-scrollbar-hover-width : Theme.size-scrollbar-width;
    height: 100%;
    background: transparent;
    visible: root.content-height > root.viewport-height;

    animate width {
        // motion.rs: damping 0.85 -> bounce = 0.15. Slint requires a literal.
        duration: Motion.scrollbar-spring;
        easing: spring(0.15);
    }

    property <length> travel: root.height - thumb.height;
    property <length> thumb-height: Math.max(
        Theme.size-scrollbar-min-thumb,
        root.height * (root.viewport-height / root.content-height),
    );
    property <length> thumb-y:
        root.offset / (root.content-height - root.viewport-height) * travel;
    property <bool> lit: root.hovered || touch.has-hover;

    thumb := Rectangle {
        y: root.thumb-y;
        width: parent.width;
        height: root.thumb-height;
        border-radius: self.width / 2;
        background: Theme.text-primary.with-alpha(
            root.dragging ? Theme.scrollbar-drag-alpha
            : root.lit ? Theme.scrollbar-hover-alpha
            : Theme.scrollbar-rest-alpha,
        );

        animate y, height {
            // motion.rs: damping 0.85 -> bounce = 0.15. Slint requires a literal.
            duration: Motion.scrollbar-spring;
            easing: spring(0.15);
        }
    }

    touch := TouchArea {}
}
