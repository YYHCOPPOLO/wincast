import { Theme } from "../theme.slint";
import { Keycap } from "keycap.slint";
import { Checkbox } from "checkbox.slint";

// A 26 DIP icon slot: the decoded image, or the placeholder tile + symbol.
export component IconSlot inherits Rectangle {
    in property <image> source;
    in property <bool> ready: false;
    in property <string> symbol;
    in property <length> slot: Theme.size-result-row-icon;

    width: slot;
    height: slot;
    background: transparent;

    if ready: Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: contain;
    }
    if !ready: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-thumbnail;
        background: Theme.icon-placeholder;

        if root.symbol != "": Text {
            text: root.symbol;
            font-family: "Segoe Fluent Icons";
            font-size: Theme.font-header-icon;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Section header: 22 DIP tall, 11 DIP secondary, 16 DIP content gutter.
export component SectionHeader inherits Rectangle {
    in property <string> title;

    height: Theme.size-section-header-height;
    background: transparent;

    HorizontalLayout {
        padding-left: Theme.size-row-content-left;
        padding-right: Theme.size-row-content-left;

        Text {
            text: root.title;
            font-family: "Segoe UI";
            font-size: Theme.font-section;
            font-weight: 500;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One palette result row. Selection wins over hover; hover only after arming.
// The alias capsule follows the title and never takes the trailing column.
export component Row inherits Rectangle {
    in property <string> title;
    in property <string> alias;
    in property <string> trailing;
    in property <string> keycap-text;
    in property <string> symbol;
    // 0 none, 1 off, 2 on, 3 locked; the uninstall list draws 1..3.
    in property <int> checkbox: 0;
    in property <image> icon;
    in property <bool> icon-ready: false;
    in property <bool> selected: false;
    in property <bool> hover-armed: false;

    callback clicked(length, length);

    height: Theme.size-row-height;
    border-radius: Theme.radius-row;
    background: root.selected ? Theme.selection
        : (root.hover-armed && touch.has-hover ? Theme.row-hover : transparent);

    HorizontalLayout {
        padding-left: Theme.size-row-padding-x;
        padding-right: Theme.size-row-padding-x;
        spacing: Theme.size-row-icon-gap;

        // 16 DIP box centered in the result-row icon slot; locked rows show a lock.
        if root.checkbox != 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.size-result-row-icon;
                height: Theme.size-result-row-icon;
                background: transparent;

                if root.checkbox == 3: Text {
                    text: root.symbol;
                    font-family: "Segoe Fluent Icons";
                    font-size: Theme.font-header-icon;
                    color: Theme.text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if root.checkbox != 3: Checkbox {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    checked: root.checkbox == 2;
                    interactive: false;
                }
            }
        }

        if root.checkbox == 0: VerticalLayout {
            alignment: center;
            IconSlot {
                source: root.icon;
                ready: root.icon-ready;
                symbol: root.symbol;
            }
        }

        Text {
            text: root.title;
            font-family: "Segoe UI";
            font-size: Theme.font-row;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.alias != "": Rectangle {
            height: Theme.size-key-cap;
            border-radius: Theme.radius-menu;
            background: Theme.control-surface;

            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;

                Text {
                    text: root.alias;
                    font-family: "Segoe UI";
                    font-size: Theme.font-chip;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
        }

        if root.trailing != "": Text {
            text: root.trailing;
            font-family: "Segoe UI";
            font-size: Theme.font-row-trailing;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        if root.keycap-text != "": VerticalLayout {
            alignment: center;
            Keycap { text: root.keycap-text; }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked(
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y,
            );
        }
    }
}
