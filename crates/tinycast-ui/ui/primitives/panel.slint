import { Theme } from "../theme.slint";
import { IconSlot } from "row.slint";

// The 44 DIP palette header: 10 DIP top pad lives on Panel, no divider.
export component PanelHeader inherits Rectangle {
    in property <string> text;
    in property <bool> placeholder: false;
    in property <bool> prominent: true;
    in property <string> symbol;
    in property <image> icon;
    in property <bool> icon-ready: false;

    height: Theme.size-header-height;
    background: transparent;

    HorizontalLayout {
        padding-left: Theme.spacing-md * 2;
        padding-right: Theme.spacing-md * 2;
        spacing: Theme.spacing-md;

        VerticalLayout {
            alignment: center;
            IconSlot {
                slot: Theme.size-header-icon-slot;
                source: root.icon;
                ready: root.icon-ready;
                symbol: root.symbol;
            }
        }

        Text {
            text: root.text;
            font-family: "Segoe UI";
            font-size: root.prominent ? Theme.font-search : Theme.font-panel-title;
            color: root.placeholder ? Theme.text-tertiary : Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// Opaque flat surface: the Magpie surface fill and a 1 px border. The window
// behind it is opaque too, so nothing here is drawn as glass or a scrim. The
// caller lays out a PanelHeader, content and Footer inside; the top pad is the
// panel's 10 DIP header inset and there is no bar divider.
export component Panel inherits Rectangle {
    in property <bool> expanded: true;

    width: Theme.size-panel-width;
    height: expanded ? Theme.size-panel-height : Theme.size-compact-height;
    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: Theme.size-hairline;
    border-color: Theme.border;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-top: Theme.size-header-padding;
        @children
    }
}
