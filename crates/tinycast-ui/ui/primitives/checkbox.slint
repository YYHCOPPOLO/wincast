import { Theme } from "../theme.slint";

// 16 DIP checkbox. The caller sizes the row slot; this component only draws
// the box. "interactive: false" is for rows that own the click themselves
// (the uninstall list toggles through AppCore's pointer path, never here).
export component Checkbox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> interactive: true;
    callback toggled(bool);

    width: Theme.size-checkbox;
    height: Theme.size-checkbox;
    border-radius: Theme.radius-glyph;
    border-width: Theme.size-hairline;
    border-color: root.checked ? Theme.text-primary : Theme.border;
    background: root.checked ? Theme.text-primary : transparent;

    Path {
        width: 100%;
        height: 100%;
        commands: "M 4 8 L 7 11 L 12 5";
        stroke: Theme.settings-detail;
        stroke-width: Theme.size-hairline * 1.5;
        fill: transparent;
        visible: root.checked;
    }

    touch := TouchArea {
        enabled: root.interactive;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
