// The stroke icon set: hand-authored 24 x 24 outline paths, one per logical
// name (the SF names the models already carry). Everything draws with the
// theme ink, so light and dark adapt without a second asset, and vector
// strokes stay crisp at every DPI — the Segoe Fluent glyphs rasterized badly
// at 18 DIP under femtovg.
import { Theme } from "../theme.slint";

export component GlyphIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 16px;
    in property <color> ink: Theme.text-secondary;
    width: size;
    height: size;
    background: transparent;

    // Layout centering can put an icon between device pixels at fractional
    // Windows scale factors. Snap the vector origin and raster bounds, while
    // keeping the requested DIP size as the layout footprint.
    private property <length> pixel-x: Math.round(root.absolute-position.x / 1phx) * 1phx - root.absolute-position.x;
    private property <length> pixel-y: Math.round(root.absolute-position.y / 1phx) * 1phx - root.absolute-position.y;
    private property <length> pixel-width: Math.round(root.width / 1phx) * 1phx;
    private property <length> pixel-height: Math.round(root.height / 1phx) * 1phx;

    if root.name == "switch.2": Path {
        x: root.pixel-x; y: root.pixel-y;
        width: root.pixel-width; height: root.pixel-height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.ink; stroke-width: 1.6px; fill: transparent;
        commands: "M 4 6.5 H 20 M 4 12 H 20 M 4 17.5 H 20";
    }
