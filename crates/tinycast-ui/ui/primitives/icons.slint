// The native Windows icon set. Each logical name (the SF names the models
// already carry) maps to a Segoe Fluent Icons / Segoe MDL2 Assets code point,
// so the operating system's own icon shapes draw every surface at the size
// they were designed for. The host picks the family in `Theme.icon-font`
// (Fluent on Windows 11, MDL2 where only that font is installed); the theme
// ink still drives light and dark.
import { Theme } from "../theme.slint";

export component GlyphIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 16px;
    in property <color> ink: Theme.text-secondary;
    width: size;
    height: size;
    background: transparent;

    // SF Symbol name → Segoe Fluent / MDL2 code point. Unknown names draw
    // nothing, exactly like the empty Path set did.
    pure function glyph(name: string) -> string {
        if name == "switch.2" { return "\u{E9E9}"; }
        if name == "square.grid.2x2" { return "\u{F0E2}"; }
        if name == "gearshape" { return "\u{E713}"; }
        if name == "bolt" { return "\u{E945}"; }
        if name == "power" { return "\u{E7E8}"; }
        if name == "terminal" { return "\u{E756}"; }
        if name == "link" { return "\u{E71B}"; }
        if name == "sparkles" { return "\u{F1BA}"; }
        if name == "wand.and.sparkles" { return "\u{F1D5}"; }
        if name == "doc.text.magnifyingglass" { return "\u{EE1A}"; }
        if name == "text.page" { return "\u{E8A5}"; }
        if name == "curlybraces" { return "\u{E943}"; }
        if name == "macwindow" { return "\u{E78B}"; }
        if name == "doc.on.clipboard" { return "\u{F0E3}"; }
        if name == "face.smiling" { return "\u{E76E}"; }
        if name == "calendar" { return "\u{E787}"; }
        if name == "puzzlepiece.extension" { return "\u{EA86}"; }
        if name == "lock.shield" { return "\u{EA18}"; }
        if name == "arrow.up.arrow.down.circle" { return "\u{E895}"; }
        if name == "info.circle" { return "\u{E946}"; }
        if name == "info.circle.fill" { return "\u{EA1F}"; }
        if name == "magnifyingglass" { return "\u{E721}"; }
        if name == "chevron.left" { return "\u{E76B}"; }
        if name == "chevron.down" { return "\u{E70D}"; }
        if name == "arrow.right" { return "\u{E72A}"; }
        if name == "exclamationmark.triangle" { return "\u{E7BA}"; }
        if name == "exclamationmark.circle.fill" { return "\u{E783}"; }
        if name == "lock.fill" { return "\u{E72E}"; }
        if name == "folder" { return "\u{E8B7}"; }
        if name == "doc" { return "\u{E8A5}"; }
        if name == "text.bubble" { return "\u{E8BD}"; }
        if name == "heart" { return "\u{EB51}"; }
        if name == "checkmark" { return "\u{E73E}"; }
        if name == "checkmark.circle.fill" { return "\u{E930}"; }
        if name == "speaker.wave.2" { return "\u{E767}"; }
        if name == "speaker.slash.fill" { return "\u{E74F}"; }
        if name == "speaker.slash.2" { return "\u{E74F}"; }
        if name == "rectangle.stack" { return "\u{E8F1}"; }
        if name == "plus" { return "\u{E710}"; }
        return "";
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph(root.name);
        font-family: Theme.icon-font;
        // The icon font's ink sits inside the em; one extra pixel keeps the
        // glyph at the old stroke set's optical size in the same slot.
        font-size: root.size + 1px;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
