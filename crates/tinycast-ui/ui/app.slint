export component ProbeWindow inherits Window {
    title: "探针";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    width: 420px;
    height: 360px;
    forward-focus: query;

    // View box matches squircle_commands(0, 0, 220, 120, 26).
    in property <string> squircle-commands;
    in property <color> scrim;
    in-out property <bool> entered: false;
    in-out property <bool> sprung: false;
    out property <float> intro-scale: entered ? 1 : 0.94;
    out property <float> intro-opacity: entered ? 1 : 0;
    out property <bool> query-focused: query.has-focus;
    out property <string> query-text: query.text;
    out property <string> preedit: query.preedit-text;
    out property <length> knob-x: knob.x;

    animate intro-scale {
        duration: 180ms;
        easing: cubic-bezier(0, 0, 0.58, 1);
    }
    animate intro-opacity {
        duration: 180ms;
        easing: cubic-bezier(0, 0, 0.58, 1);
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        Text {
            text: "命令面板中文正文";
            font-family: "Segoe UI";
            font-size: 13px;
            color: black;
        }

        Text {
            text: "😄";
            font-family: "Segoe UI Emoji";
            font-size: 32px;
        }

        Path {
            width: 220px;
            height: 120px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 220;
            viewbox-height: 120;
            commands: root.squircle-commands;
            fill: root.scrim;
        }

        Rectangle {
            height: 36px;
            background: transparent;
            transform-scale: root.intro-scale;
            opacity: root.intro-opacity;

            Text {
                x: 0px;
                y: 8px;
                text: "进入";
                font-family: "Segoe UI";
                font-size: 13px;
                color: black;
            }
        }

        Rectangle {
            height: 28px;
            background: #00000014;
            horizontal-stretch: 1;

            knob := Rectangle {
                x: root.sprung ? 160px : 0px;
                y: 4px;
                width: 20px;
                height: 20px;
                background: black;
                border-radius: 10px;

                animate x {
                    duration: 280ms;
                    easing: spring(0.15);
                }
            }
        }

        Rectangle {
            height: 32px;
            background: white;
            border-width: 1px;
            border-color: black;

            query := TextInput {
                x: 6px;
                y: 4px;
                width: parent.width - 12px;
                height: parent.height - 8px;
                font-family: "Segoe UI";
                font-size: 13px;
                color: black;
                single-line: true;
            }
        }
    }

    init => {
        query.focus();
    }
}
